                <name>MXEN</name>
                <description>Test mux enable</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <!--DT: Fractional noise randomization mode-->
              <field>
                <name>DT</name>
                <description>Fractional noise randomization mode</description>
                <bitRange>[25:24]</bitRange>
                <access>read-write</access>
              </field>
              <!--DLDMODE: Frequency detector delay-->
              <field>
                <name>DLDMODE</name>
                <description>Frequency detector delay</description>
                <bitRange>[22:22]</bitRange>
                <access>read-write</access>
              </field>
              <!--VCOMF: Ajust lower range of GUN-->
              <field>
                <name>VCOMF</name>
                <description>Ajust lower range of GUN</description>
                <bitRange>[21:21]</bitRange>
                <access>read-write</access>
              </field>
              <!--VCOMA: Ajust amplitude of GUN-->
              <field>
                <name>VCOMA</name>
                <description>Ajust amplitude of GUN</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
              </field>
              <!--VCOMODE: Subband selection signal-->
              <field>
                <name>VCOMODE</name>
                <description>Subband selection signal</description>
                <bitRange>[19:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--LPF: Loop filter band-->
              <field>
                <name>LPF</name>
                <description>Loop filter band</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
              </field>
              <!--PFD: Mode of current switch-->
              <field>
                <name>PFD</name>
                <description>Mode of current switch</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <!--CP: Output current of current switch-->
              <field>
                <name>CP</name>
                <description>Output current of current switch</description>
                <bitRange>[11:8]</bitRange>
                <access>read-write</access>
              </field>
              <!--ST: Sigma-delta modulator mode-->
              <field>
                <name>ST</name>
                <description>Sigma-delta modulator mode</description>
                <bitRange>[7:5]</bitRange>
                <access>read-write</access>
              </field>
              <!--SP: Song-Park mode-->
              <field>
                <name>SP</name>
                <description>Song-Park mode</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <!--CLKSEL: Select reference clock-->
              <field>
                <name>CLKSEL</name>
                <description>Select reference clock</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HSE</name>
                    <description>HSE oscillator(src_clk)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EXT</name>
                    <description>external clock from gpio</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <!--FOUTEN: Fout enable-->
              <field>
                <name>FOUTEN</name>
                <description>Fout enable</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <!--BYPASS: Bypass enable-->
              <field>
                <name>BYPASS</name>
                <description>Bypass enable</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <!--PD: Powerdown enable-->
              <field>
                <name>PD</name>
                <description>Powerdown enable</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DIV</name>
            <description>PLL DIV Configuration Register</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--NDIV: Integer part of divider-->
              <field>
                <name>NDIV</name>
                <description>Integer part of divider</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
              <!--RDIV: R-divider coefficient-->
              <field>
                <name>RDIV</name>
                <description>R-divider coefficient</description>
                <bitRange>[21:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--RNCLR: R-divider enable-->
              <field>
                <name>RNCLR</name>
                <description>R-divider enable</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <!--NNCLR: N-divider enable-->
              <field>
                <name>NNCLR</name>
                <description>N-divider enable</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <!--PREDIV: Predivisor coefficient-->
              <field>
                <name>PREDIV</name>
                <description>Predivisor coefficient</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <!--DIV1B: Divider 1B-->
              <field>
                <name>DIV1B</name>
                <description>Divider 1B</description>
                <bitRange>[9:4]</bitRange>
                <access>read-write</access>
              </field>
              <!--DIV1A: Divider 1A-->
              <field>
                <name>DIV1A</name>
                <description>Divider 1A</description>
                <bitRange>[2:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>FRAC</name>
            <description>PLL FRAC Configuration Register</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--FRAC: Numerator of fractional part-->
              <field>
                <name>FRAC</name>
                <description>Numerator of fractional part</description>
                <bitRange>[23:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MOD</name>
            <description>PLL MOD Configuration Register</description>
            <addressOffset>0xc</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--MOD: Denominator of fractional part-->
              <field>
                <name>MOD</name>
                <description>Denominator of fractional part</description>
                <bitRange>[23:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--PLLSTAT: PLLs status regisoter-->
        <register>
          <name>PLLSTAT</name>
          <description>PLLs status regisoter</description>
          <addressOffset>0x130</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--PLL2LOCK: -->
            <field>
              <name>PLL2LOCK</name>
              <description />
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--PLL1LOCK: -->
            <field>
              <name>PLL1LOCK</name>
              <description />
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <!--SYSPLLLOCK: -->
            <field>
              <name>SYSPLLLOCK</name>
              <description />
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--RTC-->
    <peripheral>
      <name>RTC</name>
      <version>1.0</version>
      <description>RTC control registers</description>
      <groupName>RTC</groupName>
      <baseAddress>0x50005000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x60</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>RTC</name>
        <description>RTC combine interrupt</description>
        <value>3</value>
      </interrupt>
      <interrupt>
        <name>RTC_ALARM1</name>
        <description>RTC alarm 1 interrupt</description>
        <value>214</value>
      </interrupt>
      <interrupt>
        <name>RTC_ALARM2</name>
        <description>RTC alarm 2 interrupt</description>
        <value>215</value>
      </interrupt>
      <interrupt>
        <name>RTC_BATTERY</name>
        <description>RTC switch to battery power supply interrupt</description>
        <value>216</value>
      </interrupt>
      <interrupt>
        <name>RTC_N_POWER</name>
        <description>RTC switch to normal power supply interrupt</description>
        <value>217</value>
      </interrupt>
      <interrupt>
        <name>RTC_OVERFLOW</name>
        <description>RTC counter overflow interrupt</description>
        <value>218</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--TIME: Time register-->
        <register>
          <name>TIME</name>
          <description>Time register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Time value-->
            <field>
              <name>VAL</name>
              <description>Time value</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ALARM1: Alarm 1 register-->
        <register>
          <name>ALARM1</name>
          <description>Alarm 1 register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Alarm value-->
            <field>
              <name>VAL</name>
              <description>Alarm value</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ALARM2: Alarm 2 register-->
        <register>
          <name>ALARM2</name>
          <description>Alarm 2 register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Alarm value-->
            <field>
              <name>VAL</name>
              <description>Alarm value</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CONTROL: Control register-->
        <register>
          <name>CONTROL</name>
          <description>Control register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--FCM: Use 32kHz instead of 1Hz clock signal-->
            <field>
              <name>FCM</name>
              <description>Use 32kHz instead of 1Hz clock signal</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_MODE</name>
                  <description>The time register is incremented each second</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FAST_MODE</name>
                  <description>32 kHz clock is used to increment the time register</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DRC: Disable RC generator-->
            <field>
              <name>DRC</name>
              <description>Disable RC generator</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--OIE: Timer overflow interrupt enable-->
            <field>
              <name>OIE</name>
              <description>Timer overflow interrupt enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--NPIE: Switch to normal power supply interrupt enable-->
            <field>
              <name>NPIE</name>
              <description>Switch to normal power supply interrupt enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BIE: Power switched to battery interrupt enable-->
            <field>
              <name>BIE</name>
              <description>Power switched to battery interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--A2IE: Alarm 2 interrupt enable-->
            <field>
              <name>A2IE</name>
              <description>Alarm 2 interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--A1IE: Alarm 1 interrupt enable-->
            <field>
              <name>A1IE</name>
              <description>Alarm 1 interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STATUS: Status register-->
        <register>
          <name>STATUS</name>
          <description>Status register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BU: Battery supply is used status-->
            <field>
              <name>BU</name>
              <description>Battery supply is used status</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <!--OSCOK: RC oscillator state is ok-->
            <field>
              <name>OSCOK</name>
              <description>RC oscillator state is ok</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--OF: Timer overflow was detected-->
            <field>
              <name>OF</name>
              <description>Timer overflow was detected</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--NPF: Switch to normal power supply was detected-->
            <field>
              <name>NPF</name>
              <description>Switch to normal power supply was detected</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BF: Power switched  to battery flag-->
            <field>
              <name>BF</name>
              <description>Power switched  to battery flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--A2F: Alarm 2 flag-->
            <field>
              <name>A2F</name>
              <description>Alarm 2 flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--A1F: Alarm 1 flag-->
            <field>
              <name>A1F</name>
              <description>Alarm 1 flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--RCTRIM: RC trim register-->
        <register>
          <name>RCTRIM</name>
          <description>RC trim register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SIGN: Sign of trim value-->
            <field>
              <name>SIGN</name>
              <description>Sign of trim value</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--TRIMVAL: Trim value-->
            <field>
              <name>TRIMVAL</name>
              <description>Trim value</description>
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--SECTRIM: One second clock trim register-->
        <register>
          <name>SECTRIM</name>
          <description>One second clock trim register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SIGN: Sign of trim value-->
            <field>
              <name>SIGN</name>
              <description>Sign of trim value</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--TRIMVAL: Trim value-->
            <field>
              <name>TRIMVAL</name>
              <description>Trim value</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--GPR: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-15</dimIndex>
          <!--end of dimElementGroup-->
          <name>GPR[%s]</name>
          <description>GPR</description>
          <addressOffset>0x20</addressOffset>
          <register>
            <name>VALUE</name>
            <description>General purpose register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Value-->
              <field>
                <name>VAL</name>
                <description>Value</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <!--WDT-->
    <peripheral>
      <name>WDT</name>
      <version>1.0</version>
      <description>Watchdog timer</description>
      <groupName>WDT</groupName>
      <baseAddress>0x50006000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0xc04</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>WDT</name>
        <description>Watchdog timer interrupt</description>
        <value>1</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--LOAD: Watchdog Load Register-->
        <register>
          <name>LOAD</name>
          <description>Watchdog Load Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Begin value counter-->
            <field>
              <name>VAL</name>
              <description>Begin value counter</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--VALUE: Watchdog Value Register-->
        <register>
          <name>VALUE</name>
          <description>Watchdog Value Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Current value counter-->
            <field>
              <name>VAL</name>
              <description>Current value counter</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CTRL: Watchdog Control Register-->
        <register>
          <name>CTRL</name>
          <description>Watchdog Control Register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RESEN: Enable watchdog reset output-->
            <field>
              <name>RESEN</name>
              <description>Enable watchdog reset output</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--INTEN: Enable the interrupt event-->
            <field>
              <name>INTEN</name>
              <description>Enable the interrupt event</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--INTCLR: Watchdog Clear Interrupt Register-->
        <register>
          <name>INTCLR</name>
          <description>Watchdog Clear Interrupt Register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WDTCLR: Reset interrupt WDT-->
            <field>
              <name>WDTCLR</name>
              <description>Reset interrupt WDT</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--RIS: Watchdog Raw Interrupt Status Register-->
        <register>
          <name>RIS</name>
          <description>Watchdog Raw Interrupt Status Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RAWWDTINT: Raw interrupt status from the counter-->
            <field>
              <name>RAWWDTINT</name>
              <description>Raw interrupt status from the counter</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--MIS: Watchdog Interrupt Status Register-->
        <register>
          <name>MIS</name>
          <description>Watchdog Interrupt Status Register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WDTINT: Enabled interrupt status from the counter-->
            <field>
              <name>WDTINT</name>
              <description>Enabled interrupt status from the counter</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--LOCK: Watchdog Lock Register (write)-->
        <register>
          <name>LOCK</name>
          <description>Watchdog Lock Register (write)</description>
          <addressOffset>0xc00</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CODE: Enable write access to all other registers by writing LOCK = 0x1ACCE551. Disable write to any othr registers of Watchdog by writing any other value-->
            <field>
              <name>CODE</name>
              <description>Enable write access to all other registers by writing LOCK = 0x1ACCE551. Disable write to any othr registers of Watchdog by writing any other value</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
              <usage>write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UNLOCK</name>
                  <description>Value that clear LOCKSTAT.REGWRDIS bit</description>
                  <value>449635665</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCK_0</name>
                  <description>Example value that set LOCKSTAT.REGWRDIS (write to all registers except LOCK is disabled)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCK_1</name>
                  <description>Example value that set LOCKSTAT.REGWRDIS (write to all registers except LOCK is disabled)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--LOCKSTAT: Watchdog Lock Register (read)-->
        <register>
          <name>LOCKSTAT</name>
          <description>Watchdog Lock Register (read)</description>
          <alternateRegister>LOCK</alternateRegister>
          <addressOffset>0xc00</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--REGWRDIS: Write to all registers of Watchdog is disabled-->
            <field>
              <name>REGWRDIS</name>
              <description>Write to all registers of Watchdog is disabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--SRAM-->
    <peripheral>
      <name>SRAM</name>
      <version>1.0</version>
      <description>SRAM ECC control unit</description>
      <groupName>SRAM</groupName>
      <baseAddress>0x50007000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x2c</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SRAM</name>
        <description>SRAM interrupt</description>
        <value>5</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CFG: SRAM ECC Control register-->
        <register>
          <name>CFG</name>
          <description>SRAM ECC Control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ERRINJEN: Enable error injection on write data bus-->
            <field>
              <name>ERRINJEN</name>
              <description>Enable error injection on write data bus</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--EN: Enable ECC-->
            <field>
              <name>EN</name>
              <description>Enable ECC</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--IRQEN: SRAM ECC Interrupt Enable register-->
        <register>
          <name>IRQEN</name>
          <description>SRAM ECC Interrupt Enable register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DEUEN: Enable interrupt when double errors detected-->
            <field>
              <name>DEUEN</name>
              <description>Enable interrupt when double errors detected</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--SEUEN: Enable interrupt when single error detected-->
            <field>
              <name>SEUEN</name>
              <description>Enable interrupt when single error detected</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--IRQSTAT: SRAM ECC Interrupt Status register-->
        <register>
          <name>IRQSTAT</name>
          <description>SRAM ECC Interrupt Status register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DEU: Double error occurred-->
            <field>
              <name>DEU</name>
              <description>Double error occurred</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--SEU: Single error occurred-->
            <field>
              <name>SEU</name>
              <description>Single error occurred</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ERROR_POS: SRAM Error Position in Byte register-->
        <register>
          <name>ERROR_POS</name>
          <description>SRAM Error Position in Byte register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DEU_BSEL: Byte position in a word in which double error has been occured-->
            <field>
              <name>DEU_BSEL</name>
              <description>Byte position in a word in which double error has been occured</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--SEU_BSEL: Byte position in a word in which single error has been occured-->
            <field>
              <name>SEU_BSEL</name>
              <description>Byte position in a word in which single error has been occured</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--SEU_CNTR: SRAM Single Error Counter register-->
        <register>
          <name>SEU_CNTR</name>
          <description>SRAM Single Error Counter register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Single error times occurred-->
            <field>
              <name>VAL</name>
              <description>Single error times occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DEU_CNTR: SRAM Double Error Counter register-->
        <register>
          <name>DEU_CNTR</name>
          <description>SRAM Double Error Counter register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Double error times occurred-->
            <field>
              <name>VAL</name>
              <description>Double error times occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--SEU_ADDR: SRAM Single Error Address register-->
        <register>
          <name>SEU_ADDR</name>
          <description>SRAM Single Error Address register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Last latched address when single error occurred-->
            <field>
              <name>VAL</name>
              <description>Last latched address when single error occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DEU_ADDR: SRAM Double Error Address register-->
        <register>
          <name>DEU_ADDR</name>
          <description>SRAM Double Error Address register</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Last latched address when double error occurred-->
            <field>
              <name>VAL</name>
              <description>Last latched address when double error occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--LATENCY: SRAM Read and Write Latency register-->
        <register>
          <name>LATENCY</name>
          <description>SRAM Read and Write Latency register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RD_LATENCY: SRAM Read Latency-->
            <field>
              <name>RD_LATENCY</name>
              <description>SRAM Read Latency</description>
              <bitRange>[9:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--WR_LATENCY: SRAM Write Latency-->
            <field>
              <name>WR_LATENCY</name>
              <description>SRAM Write Latency</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ERRMASK: SRAM Data Mask register-->
        <register>
          <name>ERRMASK</name>
          <description>SRAM Data Mask register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Corresponding bit of 32-bit write data bus is inverted-->
            <field>
              <name>VAL</name>
              <description>Corresponding bit of 32-bit write data bus is inverted</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--Reserved: -->
        <register>
          <name>Reserved</name>
          <description />
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
        </register>
      </registers>
    </peripheral>
    <!--TRNG-->
    <peripheral>
      <name>TRNG</name>
      <version>1.0</version>
      <description>True random number generator</description>
      <groupName>TRNG</groupName>
      <baseAddress>0x50008000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>TRNG</name>
        <description>TRNG interrupt</description>
        <value>211</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CR: Control register-->
        <register>
          <name>CR</name>
          <description>Control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x40000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BLENDMETHOD: Select blending method: 00: Concatenation; 01: XOR_LEVEL_1; 10: XOR_LEVEL_2; 11: VON-NEUMANN debiasing-->
            <field>
              <name>BLENDMETHOD</name>
              <description>Select blending method: 00: Concatenation; 01: XOR_LEVEL_1; 10: XOR_LEVEL_2; 11: VON-NEUMANN debiasing</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Concatenation</name>
                  <description>Blending method Concatenation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>XOR_LEVEL_1</name>
                  <description>Blending method XOR_LEVEL_1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>XOR_LEVEL_2</name>
                  <description>Blending method XOR_LEVEL_2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VON_NEUMANN_debiasing</name>
                  <description>Blending method VON_NEUMANN_debiasing</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CORRTSTDIS: Disable speci1c delay(s) check in correlation test - different ROs: xx1: vs. the same sample of the other RO -> (0) delay check x1x: vs. the preceding sample of the other RO -> (-1) delay check 1xx: vs. the next sample of the other RO -> (+1) delay check-->
            <field>
              <name>CORRTSTDIS</name>
              <description>Disable speci1c delay(s) check in correlation test - different ROs: xx1: vs. the same sample of the other RO -&gt; (0) delay check x1x: vs. the preceding sample of the other RO -&gt; (-1) delay check 1xx: vs. the next sample of the other RO -&gt; (+1) delay check</description>
              <bitRange>[29:27]</bitRange>
              <access>read-write</access>
            </field>
            <!--AUTOCORRDIS: Disable speci1c delay(s) check in auto-correlation test - same RO: x1: vs. the following sample of the same RO -> (0) delay check 1x: vs. the later sample of the same RO -> (+1) delay check-->
            <field>
              <name>AUTOCORRDIS</name>
              <description>Disable speci1c delay(s) check in auto-correlation test - same RO: x1: vs. the following sample of the same RO -&gt; (0) delay check 1x: vs. the later sample of the same RO -&gt; (+1) delay check</description>
              <bitRange>[24:23]</bitRange>
              <access>read-write</access>
            </field>
            <!--PROPTSTDIS: All proportion tests (each share) are disabled via this single bit-->
            <field>
              <name>PROPTSTDIS</name>
              <description>All proportion tests (each share) are disabled via this single bit</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <!--REPTSTDIS: All repetition tests (each share) are disabled via this single bit-->
            <field>
              <name>REPTSTDIS</name>
              <description>All repetition tests (each share) are disabled via this single bit</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <!--FIFOFILLST: Enable write of the samples in the FIFO during start-up-->
            <field>
              <name>FIFOFILLST</name>
              <description>Enable write of the samples in the FIFO during start-up</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--COUNTBLOCK: Number of 128-bit blocks used in conditioning (AES-CBC-MAC) post-processing. Zero value is not allowed-->
            <field>
              <name>COUNTBLOCK</name>
              <description>Number of 128-bit blocks used in conditioning (AES-CBC-MAC) post-processing. Zero value is not allowed</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--IGNORHTF: Results of the health tests during start-up and online test do not affect the control FSM state. It also bypass control FSM StartUp phase-->
            <field>
              <name>IGNORHTF</name>
              <description>Results of the health tests during start-up and online test do not affect the control FSM state. It also bypass control FSM StartUp phase</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--FORCEROS: Force oscillators to run when FIFO is full-->
            <field>
              <name>FORCEROS</name>
              <description>Force oscillators to run when FIFO is full</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--SOFTRST: Datapath content 2ush and control FSM reset: 0: Normal mode; 1: Datapath components - the health tests, the conditioning function and the FIFO - are cleared. This bit is not cleared automatically. Configuration registers preserve their values. Send control FSM to Reset state.-->
            <field>
              <name>SOFTRST</name>
              <description>Datapath content 2ush and control FSM reset: 0: Normal mode; 1: Datapath components - the health tests, the conditioning function and the FIFO - are cleared. This bit is not cleared automatically. Configuration registers preserve their values. Send control FSM to Reset state.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--FFULLINTEN: Enable interrupt if FIFO is full-->
            <field>
              <name>FFULLINTEN</name>
              <description>Enable interrupt if FIFO is full</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--TFAILINTEN: Enable interrupt if any of the health test fails-->
            <field>
              <name>TFAILINTEN</name>
              <description>Enable interrupt if any of the health test fails</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--CONDBYPASS: 0: Conditioning function is used (normal mode); 1: Conditioning function is bypassed (to observe entropy source directly)-->
            <field>
              <name>CONDBYPASS</name>
              <description>0: Conditioning function is used (normal mode); 1: Conditioning function is bypassed (to observe entropy source directly)</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--TESTEN: Select input for conditioning function and continuous tests: 0: Noise source (normal mode) 1: Test data register (test mode)-->
            <field>
              <name>TESTEN</name>
              <description>Select input for conditioning function and continuous tests: 0: Noise source (normal mode) 1: Test data register (test mode)</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--LFSR: Select between the NDRNG with asynchronous free running oscillators (when 0) and the Pseudo-Random generator with synchronous oscillators-->
            <field>
              <name>LFSR</name>
              <description>Select between the NDRNG with asynchronous free running oscillators (when 0) and the Pseudo-Random generator with synchronous oscillators</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AsyncFreeRunOsc</name>
                  <description>NDRNG with asynchronous free running oscillators</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SyncOsc</name>
                  <description>Pseudo-Random generator with synchronous oscillators for simulation purpose</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--START: Start/enable the NDRNG-->
            <field>
              <name>START</name>
              <description>Start/enable the NDRNG</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FIFOLEV: FIFO Level register-->
        <register>
          <name>FIFOLEV</name>
          <description>FIFO Level register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Number of 32 bits words of random available in the FIFO. Any write to this register clears the FifoFull 2ag in the Status register.-->
            <field>
              <name>VAL</name>
              <description>Number of 32 bits words of random available in the FIFO. Any write to this register clears the FifoFull 2ag in the Status register.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FIFOTHR: FIFO Threshold register-->
        <register>
          <name>FIFOTHR</name>
          <description>FIFO Threshold register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x7</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: FIFO level below which the module starts to refill the FIFO, expressed in number of 128bit blocks.-->
            <field>
              <name>VAL</name>
              <description>FIFO level below which the module starts to refill the FIFO, expressed in number of 128bit blocks.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FIFODEP: FIFO Depth register-->
        <register>
          <name>FIFODEP</name>
          <description>FIFO Depth register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x20</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Maximum number of 32 bits words that can be stored in the FIFO-->
            <field>
              <name>VAL</name>
              <description>Maximum number of 32 bits words that can be stored in the FIFO</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--KEY: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>KEY[%s]</name>
          <description>KEY</description>
          <addressOffset>0x10</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Key register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Bits form the 128-bit AES key-->
              <field>
                <name>VAL</name>
                <description>Bits form the 128-bit AES key</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--TESTDATA: Test data register-->
        <register>
          <name>TESTDATA</name>
          <description>Test data register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Test data-->
            <field>
              <name>VAL</name>
              <description>Test data</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--REPTSTCUTOFF: Cut-off value for the repetition tests register-->
        <register>
          <name>REPTSTCUTOFF</name>
          <description>Cut-off value for the repetition tests register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x6</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Cut-off value for the repetition tests-->
            <field>
              <name>VAL</name>
              <description>Cut-off value for the repetition tests</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PROPTESTCUTOFF: Proportion test cut-off value register-->
        <register>
          <name>PROPTESTCUTOFF</name>
          <description>Proportion test cut-off value register</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x3e</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Proportion test cut-off value-->
            <field>
              <name>VAL</name>
              <description>Proportion test cut-off value</description>
              <bitRange>[8:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--LFSRSEED: LFSR Seed register-->
        <register>
          <name>LFSRSEED</name>
          <description>LFSR Seed register</description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SEL: Share index for which initialization value should be used-->
            <field>
              <name>SEL</name>
              <description>Share index for which initialization value should be used</description>
              <bitRange>[25:24]</bitRange>
              <access>write-only</access>
            </field>
            <!--SEED: LFSR initialization value-->
            <field>
              <name>SEED</name>
              <description>LFSR initialization value</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STAT: Status register-->
        <register>
          <name>STAT</name>
          <description>Status register</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CONDSLOW: Conditioning consumes data slower than they are provided to it-->
            <field>
              <name>CONDSLOW</name>
              <description>Conditioning consumes data slower than they are provided to it</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--PRTSTFAILSH: NIST Proportion test failure per share-->
            <field>
              <name>PRTSTFAILSH</name>
              <description>NIST Proportion test failure per share</description>
              <bitRange>[19:16]</bitRange>
              <access>read-only</access>
            </field>
            <!--REPTSTFAILSH: NIST Repetition test failure per share-->
            <field>
              <name>REPTSTFAILSH</name>
              <description>NIST Repetition test failure per share</description>
              <bitRange>[15:12]</bitRange>
              <access>read-only</access>
            </field>
            <!--STARTUPFAIL: Start-up test(s) failure-->
            <field>
              <name>STARTUPFAIL</name>
              <description>Start-up test(s) failure</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--FIFOFULL: FIFO full status-->
            <field>
              <name>FIFOFULL</name>
              <description>FIFO full status</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--ANYTESTFAIL: Any of the enabled health tests is failing-->
            <field>
              <name>ANYTESTFAIL</name>
              <description>Any of the enabled health tests is failing</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--PROPTESTFAIL: NIST Proportion test(s) failure-->
            <field>
              <name>PROPTESTFAIL</name>
              <description>NIST Proportion test(s) failure</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--REPTESTFAIL: NIST Repetition test(s) failure-->
            <field>
              <name>REPTESTFAIL</name>
              <description>NIST Repetition test(s) failure</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--STATE: State of the control FSM-->
            <field>
              <name>STATE</name>
              <description>State of the control FSM</description>
              <bitRange>[3:1]</bitRange>
              <access>read-only</access>
              <usage>read</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Reset</name>
                  <description>State Reset</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>StartUp</name>
                  <description>State Startup</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Idle_FIFOfull</name>
                  <description>State Idle / FIFO full</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FIFOfill</name>
                  <description>State Fill FIFO</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Error</name>
                  <description>State Error</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DATABUSYTEST: High when data written to TestData register is being processed-->
            <field>
              <name>DATABUSYTEST</name>
              <description>High when data written to TestData register is being processed</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--WARMPERIOD: Warmup Period register-->
        <register>
          <name>WARMPERIOD</name>
          <description>Warmup Period register</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x200</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Number of clock cycles to wait during warm-up sequence-->
            <field>
              <name>VAL</name>
              <description>Number of clock cycles to wait during warm-up sequence</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DISOSC: Disable Oscillator registers-->
        <register>
          <name>DISOSC</name>
          <description>Disable Oscillator registers</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Disable oscillator rings 0 to size-6-->
            <field>
              <name>VAL</name>
              <description>Disable oscillator rings 0 to size-6</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--SAMPERIOD: Sampling Period register-->
        <register>
          <name>SAMPERIOD</name>
          <description>Sampling Period register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xfff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Number of clock cycles to wait between sampling moments-->
            <field>
              <name>VAL</name>
              <description>Number of clock cycles to wait between sampling moments</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--HWCFG: Hardware Configuration register-->
        <register>
          <name>HWCFG</name>
          <description>Hardware Configuration register</description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x511f</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--FIFODEP: Generic g_Log2FifoDepth value-->
            <field>
              <name>FIFODEP</name>
              <description>Generic g_Log2FifoDepth value</description>
              <bitRange>[15:12]</bitRange>
              <access>read-only</access>
            </field>
            <!--AUTOCORRTEST: Generic g_Log2NbOfAutoCorrTestsPerShare value-->
            <field>
              <name>AUTOCORRTEST</name>
              <description>Generic g_Log2NbOfAutoCorrTestsPerShare value</description>
              <bitRange>[11:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--INVCOUNT: Generic g_NbOfInverters value-->
            <field>
              <name>INVCOUNT</name>
              <description>Generic g_NbOfInverters value</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--COOLDPERIOD: Cooldown Period register-->
        <register>
          <name>COOLDPERIOD</name>
          <description>Cooldown Period register</description>
          <addressOffset>0x5c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Number of clock cycles to wait during cool-down sequence-->
            <field>
              <name>VAL</name>
              <description>Number of clock cycles to wait during cool-down sequence</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--AUTOCORRTESTCUTOFF0: AutoCorrTestCutoff register 0-->
        <register>
          <name>AUTOCORRTESTCUTOFF0</name>
          <description>AutoCorrTestCutoff register 0</description>
          <addressOffset>0x60</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x7f007f</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ONECUTOFF: Auto-correlation test cut-off value for delay of +1 sample-->
            <field>
              <name>ONECUTOFF</name>
              <description>Auto-correlation test cut-off value for delay of +1 sample</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--ZEROCUTOFF: Auto-correlation test cut-off value for delay of 0 samples-->
            <field>
              <name>ZEROCUTOFF</name>
              <description>Auto-correlation test cut-off value for delay of 0 samples</description>
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--AUTOCORRTESTCUTOFF1: AutoCorrTestCutoff register 1-->
        <register>
          <name>AUTOCORRTESTCUTOFF1</name>
          <description>AutoCorrTestCutoff register 1</description>
          <addressOffset>0x64</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x7f007f</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--THREECUTOFF: Auto-correlation test cut-off value for delay +3 samples-->
            <field>
              <name>THREECUTOFF</name>
              <description>Auto-correlation test cut-off value for delay +3 samples</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TWOCUTOFF: Auto-correlation test cut-off value for delay +2 samples-->
            <field>
              <name>TWOCUTOFF</name>
              <description>Auto-correlation test cut-off value for delay +2 samples</description>
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CORRTESTCUTOFF0: CorrTestCutoff register 0-->
        <register>
          <name>CORRTESTCUTOFF0</name>
          <description>CorrTestCutoff register 0</description>
          <addressOffset>0x68</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x7f007f</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ONECUTOFF: Correlation test cut-off value for time shift/delay of +/-1 sample-->
            <field>
              <name>ONECUTOFF</name>
              <description>Correlation test cut-off value for time shift/delay of +/-1 sample</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--ZEROCUTOFF: Correlation test cut-off value for time shift/delay of 0 samples-->
            <field>
              <name>ZEROCUTOFF</name>
              <description>Correlation test cut-off value for time shift/delay of 0 samples</description>
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CORRTESTCUTOFF1: CorrTestCutoff register 1-->
        <register>
          <name>CORRTESTCUTOFF1</name>
          <description>CorrTestCutoff register 1</description>
          <addressOffset>0x6c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x7f007f</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--THREECUTOFF: Correlation test cut-off value for time shift/delay of +/-3 samples-->
            <field>
              <name>THREECUTOFF</name>
              <description>Correlation test cut-off value for time shift/delay of +/-3 samples</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TWOCUTOFF: Correlation test cut-off value for time shift/delay of +/-2 samples-->
            <field>
              <name>TWOCUTOFF</name>
              <description>Correlation test cut-off value for time shift/delay of +/-2 samples</description>
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--AUTOCORRTESTFAILED: AutoCorrTestFailed register-->
        <register>
          <name>AUTOCORRTESTFAILED</name>
          <description>AutoCorrTestFailed register</description>
          <addressOffset>0x70</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Auto-correlation test failing ring(s)-->
            <field>
              <name>VAL</name>
              <description>Auto-correlation test failing ring(s)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CORRTESTFAILED: CorrTestFailed register-->
        <register>
          <name>CORRTESTFAILED</name>
          <description>CorrTestFailed register</description>
          <addressOffset>0x74</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Correlation test failing rings-->
            <field>
              <name>VAL</name>
              <description>Correlation test failing rings</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--HWVERSION: Hardware Version register-->
        <register>
          <name>HWVERSION</name>
          <description>Hardware Version register</description>
          <addressOffset>0x7c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--HWVER: -->
            <field>
              <name>HWVER</name>
              <description />
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--FIFO: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>32</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-31</dimIndex>
          <!--end of dimElementGroup-->
          <name>FIFO[%s]</name>
          <description>FIFO</description>
          <addressOffset>0x80</addressOffset>
          <register>
            <name>VALUE</name>
            <description>FIFO register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Result-->
              <field>
                <name>VAL</name>
                <description>Result</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <!--EMC-->
    <peripheral>
      <name>EMC</name>
      <version>1.0</version>
      <description>External memory control module</description>
      <groupName>EMC</groupName>
      <baseAddress>0x50009000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--WINCFG: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-7</dimIndex>
          <!--end of dimElementGroup-->
          <name>WINCFG[%s]</name>
          <description>WINCFG</description>
          <addressOffset>0x0</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Window Configuration</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x7070701</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--TACYC: Turnaround cycles-->
              <field>
                <name>TACYC</name>
                <description>Turnaround cycles</description>
                <bitRange>[27:24]</bitRange>
                <access>read-write</access>
              </field>
              <!--WRCYC: Additional Write cycles-->
              <field>
                <name>WRCYC</name>
                <description>Additional Write cycles</description>
                <bitRange>[19:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--RDCYC: Additional Read cycles-->
              <field>
                <name>RDCYC</name>
                <description>Additional Read cycles</description>
                <bitRange>[11:8]</bitRange>
                <access>read-write</access>
              </field>
              <!--MODE: 8/16 bit mode. When 1 - 16 bit mode enabled-->
              <field>
                <name>MODE</name>
                <description>8/16 bit mode. When 1 - 16 bit mode enabled</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>8bit</name>
                    <description>8 bit mode</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16bit</name>
                    <description>16 bit mode</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <!--SDRAM-->
    <peripheral>
      <name>SDRAM</name>
      <version>1.0</version>
      <description>SDRAM controller unit</description>
      <groupName>SDRAM</groupName>
      <baseAddress>0x5000A000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1c</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--TIMING: SDRAM Timing register-->
        <register>
          <name>TIMING</name>
          <description>SDRAM Timing register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x17224</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--T_WR: SDRAM write recovery time, specified in clocks-->
            <field>
              <name>T_WR</name>
              <description>SDRAM write recovery time, specified in clocks</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--T_RC_AR: SDRAM active to active/auto-refresh command period, specified in clocks-->
            <field>
              <name>T_RC_AR</name>
              <description>SDRAM active to active/auto-refresh command period, specified in clocks</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--T_RCD: SDRAM active to read or write delay, specified in clocks-->
            <field>
              <name>T_RCD</name>
              <description>SDRAM active to read or write delay, specified in clocks</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--T_RP: SDRAM precharge command period, specified in clocks-->
            <field>
              <name>T_RP</name>
              <description>SDRAM precharge command period, specified in clocks</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--T_RAS: SDRAM active to prechardge, specified in clocks-->
            <field>
              <name>T_RAS</name>
              <description>SDRAM active to prechardge, specified in clocks</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--REFRESH: SDRAM Refresh register-->
        <register>
          <name>REFRESH</name>
          <description>SDRAM Refresh register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x6100</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RF_MAX: Maximum number of rows to be refreshed at a time-->
            <field>
              <name>RF_MAX</name>
              <description>Maximum number of rows to be refreshed at a time</description>
              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--RF_TIME: Period between auto-refresh commands issued by the controller, specified in clocks-->
            <field>
              <name>RF_TIME</name>
              <description>Period between auto-refresh commands issued by the controller, specified in clocks</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--MODE: SDRAM Mode register-->
        <register>
          <name>MODE</name>
          <description>SDRAM Mode register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x33</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WBMODE: Writing burst mode-->
            <field>
              <name>WBMODE</name>
              <description>Writing burst mode</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PBL</name>
                  <description>Programmed burst length</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLA</name>
                  <description>Single location address</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--OPMODE: Operating mode-->
            <field>
              <name>OPMODE</name>
              <description>Operating mode</description>
              <bitRange>[8:7]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>Normal operating mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESERV1</name>
                  <description>Reserved</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESERV2</name>
                  <description>Reserved</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESERV3</name>
                  <description>Reserved</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CAS_LATENCY: SDRAM CAS latency, specified in clocks-->
            <field>
              <name>CAS_LATENCY</name>
              <description>SDRAM CAS latency, specified in clocks</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--BURST_TYPE: Burst type-->
            <field>
              <name>BURST_TYPE</name>
              <description>Burst type</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SEQUENTIAL</name>
                  <description>Sequential burst type</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INTERLEAVED</name>
                  <description>Interleaved burst type</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--BURST_LENGTH: Burst length-->
            <field>
              <name>BURST_LENGTH</name>
              <description>Burst length</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CONTROL: SDRAM Control register-->
        <register>
          <name>CONTROL</name>
          <description>SDRAM Control register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x30000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--REQ_DEPTH: How many requests internal buffer should hold-->
            <field>
              <name>REQ_DEPTH</name>
              <description>How many requests internal buffer should hold</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--COLUMN_WIDTH: SDRAM Column Bit-->
            <field>
              <name>COLUMN_WIDTH</name>
              <description>SDRAM Column Bit</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BIT8</name>
                  <description>8 bit</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BIT9</name>
                  <description>9 bit</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BIT10</name>
                  <description>10 bits</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BIT11</name>
                  <description>11 bits</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DATA_WIDTH: SDRAM Data Width-->
            <field>
              <name>DATA_WIDTH</name>
              <description>SDRAM Data Width</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DATA32</name>
                  <description>32-bit SDRAM</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATA16</name>
                  <description>16-bit SDRAM</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATA8</name>
                  <description>8-bit SDRAM</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESERVED</name>
                  <description>Reserved</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SLOW_BUS: Must be set if System clock frequency is less than SDRAM frequency-->
            <field>
              <name>SLOW_BUS</name>
              <description>Must be set if System clock frequency is less than SDRAM frequency</description>
              <bitRange>[1:1]</bitRange>

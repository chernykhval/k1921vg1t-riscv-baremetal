        <!--RSTSYS: System Reset Register-->
        <register>
          <name>RSTSYS</name>
          <description>System Reset Register</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--KEY: KEY 'A55A' in hexadecimal for unblocking-->
            <field>
              <name>KEY</name>
              <description>KEY 'A55A' in hexadecimal for unblocking</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>
            <!--RSTEN: Reset enable-->
            <field>
              <name>RSTEN</name>
              <description>Reset enable</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--RSTSTAT: Reset Status Register-->
        <register>
          <name>RSTSTAT</name>
          <description>Reset Status Register</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--UVD33: Reset due to AVDD upper voltage detect (20% up with nominal values)-->
            <field>

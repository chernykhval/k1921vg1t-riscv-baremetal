    <!--CRYPTO-->
    <peripheral>
      <name>CRYPTO</name>
      <version>1.0</version>
      <description>Cryptographic calculation support module</description>
      <groupName>CRYPTO</groupName>
      <baseAddress>0x41070000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x8c</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>CRYPTO</name>
        <description>CRYPTO interrupt</description>
        <value>213</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--IV: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>IV[%s]</name>
          <description>IV</description>
          <addressOffset>0x0</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Initialization vector register 0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Initialization vector register (word i).  Bits 32*(4-i)-1 to 32*(3-i) for AES_128, AES_256, Kuznechik / Bits 32*(2-i)-1 to 32*(1-i) for Magma (i < 2)-->
              <field>
                <name>VAL</name>
                <description>Initialization vector register (word i).  Bits 32*(4-i)-1 to 32*(3-i) for AES_128, AES_256, Kuznechik / Bits 32*(2-i)-1 to 32*(1-i) for Magma (i &lt; 2)</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--TEXT_IN: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>TEXT_IN[%s]</name>
          <description>TEXT_IN</description>
          <addressOffset>0x10</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Input text regiter 0 (plain text / cipher text)</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Text in registers (word i).  Bits 32*(4-i)-1 to 32*(3-i) for AES_128, AES_256, Kuznechik / Bits 32*(2-i)-1 to 32*(1-i) for Magma (i < 2)-->
              <field>
                <name>VAL</name>
                <description>Text in registers (word i).  Bits 32*(4-i)-1 to 32*(3-i) for AES_128, AES_256, Kuznechik / Bits 32*(2-i)-1 to 32*(1-i) for Magma (i &lt; 2)</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--KEY: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-7</dimIndex>
          <!--end of dimElementGroup-->
          <name>KEY[%s]</name>
          <description>KEY</description>
          <addressOffset>0x20</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Secret key register 0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Key registers (word i).  Bits 32*(8-i)-1 to 32*(7-i) for AES_256, Magma, Kuznechik / Bits 32*(4-i)-1 to 32*(3-i) for AES_128 (i < 4)-->
              <field>
                <name>VAL</name>
                <description>Key registers (word i).  Bits 32*(8-i)-1 to 32*(7-i) for AES_256, Magma, Kuznechik / Bits 32*(4-i)-1 to 32*(3-i) for AES_128 (i &lt; 4)</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--IRQ_ENABLE: Interrupt enable register-->

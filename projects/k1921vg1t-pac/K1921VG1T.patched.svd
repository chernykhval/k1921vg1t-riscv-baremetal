            </field>
            <!--DS: Duplex Status-->
            <field>
              <name>DS</name>
              <description>Duplex Status</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HALF_DUPLEX</name>
                  <description>Half-duplex status</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL_DUPLEX</name>
                  <description>Full-duplex status</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--LCS: Line Clock Speed-->
            <field>
              <name>LCS</name>
              <description>Line Clock Speed</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>10MBIT</name>
                  <description>2.5 MHz RXC Clock speed</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100MBIT</name>
                  <description>25 MHz RXC Clock speed</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1G</name>
                  <description>125MHz RXC Clock speed</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reserved</name>
                  <description>Reserved</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--LS: Link Status-->
            <field>
              <name>LS</name>
              <description>Link Status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DOWN</name>
                  <description>down</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UP</name>
                  <description>up</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--WRAP_100M: RGMII 25MHz clock wrap register-->
        <register>
          <name>WRAP_100M</name>
          <description>RGMII 25MHz clock wrap register</description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WRAP: Number of GTX_CLK cycles to generate 25Mhz clock pattern-->
            <field>
              <name>WRAP</name>
              <description>Number of GTX_CLK cycles to generate 25Mhz clock pattern</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--EDGE1_100M: RGMII 25 MHz first edge register-->
        <register>
          <name>EDGE1_100M</name>
          <description>RGMII 25 MHz first edge register</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--EDGE1: Number of GTX_CLK cycles to before clock change state-->
            <field>
              <name>EDGE1</name>
              <description>Number of GTX_CLK cycles to before clock change state</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--EDGE2_100M: RGMII 25 MHz second edge register-->
        <register>
          <name>EDGE2_100M</name>
          <description>RGMII 25 MHz second edge register</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--EDGE2: Number of GTX_CLK cycles after the first edge the clock change state-->
            <field>
              <name>EDGE2</name>
              <description>Number of GTX_CLK cycles after the first edge the clock change state</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--WRAP_10M: RGMII 2.5MHz clock wrap register-->
        <register>
          <name>WRAP_10M</name>
          <description>RGMII 2.5MHz clock wrap register</description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WRAP: Number of GTX_CLK cycles to generate 25Mhz clock pattern-->
            <field>
              <name>WRAP</name>
              <description>Number of GTX_CLK cycles to generate 25Mhz clock pattern</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--EDGE1_10M: RGMII 2.5 MHz first edge register-->
        <register>
          <name>EDGE1_10M</name>
          <description>RGMII 2.5 MHz first edge register</description>
          <addressOffset>0x5c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--EDGE1: Number of GTX_CLK cycles to before clock change state-->
            <field>
              <name>EDGE1</name>
              <description>Number of GTX_CLK cycles to before clock change state</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--EDGE2_10M: RGMII 2.5 MHz second edge register-->
        <register>
          <name>EDGE2_10M</name>
          <description>RGMII 2.5 MHz second edge register</description>
          <addressOffset>0x60</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--EDGE2: Number of GTX_CLK cycles after the first edge the clock change state-->
            <field>
              <name>EDGE2</name>
              <description>Number of GTX_CLK cycles after the first edge the clock change state</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--BIT_PATTERN: RGMII bit pattern register-->
        <register>
          <name>BIT_PATTERN</name>
          <description>RGMII bit pattern register</description>
          <addressOffset>0x64</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x23838</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--P125M: Pattern for generating 125Mhz clock-->
            <field>
              <name>P125M</name>
              <description>Pattern for generating 125Mhz clock</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--P25M: Pattern for generating 25Mhz clock-->
            <field>
              <name>P25M</name>
              <description>Pattern for generating 25Mhz clock</description>
              <bitRange>[13:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--P2M5: Pattern for generating 2.5Mhz clock-->
            <field>
              <name>P2M5</name>
              <description>Pattern for generating 2.5Mhz clock</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--NEG_DELAY: RGMII positive clock data receiver delay register-->
        <register>
          <name>NEG_DELAY</name>
          <description>RGMII positive clock data receiver delay register</description>
          <addressOffset>0x68</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DELAY: Number of RX clock cycles to delay input data-->
            <field>
              <name>DELAY</name>
              <description>Number of RX clock cycles to delay input data</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--POS_DELAY: RGMII negative clock data receiver delay register-->
        <register>
          <name>POS_DELAY</name>
          <description>RGMII negative clock data receiver delay register</description>
          <addressOffset>0x6c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DELAY: Number of RX clock cycles to delay input data-->
            <field>
              <name>DELAY</name>
              <description>Number of RX clock cycles to delay input data</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--BIT_SWAP: RGMII receiver sample order swap register-->
        <register>
          <name>BIT_SWAP</name>
          <description>RGMII receiver sample order swap register</description>
          <addressOffset>0x70</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SWAP: Change data order on RxD RGMII to GMII output-->
            <field>
              <name>SWAP</name>
              <description>Change data order on RxD RGMII to GMII output</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DATA_SWAP: RGMII receiver data swap register-->
        <register>
          <name>DATA_SWAP</name>
          <description>RGMII receiver data swap register</description>
          <addressOffset>0x74</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SWAP: Swaps data between negative and positive clocked data input-->
            <field>
              <name>SWAP</name>
              <description>Swaps data between negative and positive clocked data input</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CTRL_SWAP: RGMII receiver control signal swap register-->
        <register>
          <name>CTRL_SWAP</name>
          <description>RGMII receiver control signal swap register</description>
          <addressOffset>0x78</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SWAP: Swaps control signals lines RX_DV and RXC-->
            <field>
              <name>SWAP</name>
              <description>Swaps control signals lines RX_DV and RXC</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PHYCFG: ETH PHY control register-->
        <register>
          <name>PHYCFG</name>
          <description>ETH PHY control register</description>
          <addressOffset>0x7c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--EXTPHY: Use external PHY Layer-->
            <field>
              <name>EXTPHY</name>
              <description>Use external PHY Layer</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--FLASHD-->
    <peripheral>
      <name>FLASHD</name>
      <version>1.0</version>
      <description>Flash control registers</description>
      <groupName>FLASHD</groupName>
      <baseAddress>0x5000C000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1a0</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--ADDR: Address Register-->
        <register>
          <name>ADDR</name>
          <description>Address Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ADDRESS: Address value to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value to selected flash IP</description>
              <bitRange>[18:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--NVR_ADDR: Address Register for NVR access-->
        <register>
          <name>NVR_ADDR</name>
          <description>Address Register for NVR access</description>
          <alternateRegister>ADDR</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--HIGH_SECTOR: Sector address value (msb) to selected flash IP-->
            <field>
              <name>HIGH_SECTOR</name>
              <description>Sector address value (msb) to selected flash IP</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <!--SECTOR_ADDR: Sector address value (lsb) to selected flash IP-->
            <field>
              <name>SECTOR_ADDR</name>
              <description>Sector address value (lsb) to selected flash IP</description>
              <bitRange>[12:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value within current sector to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value within current sector to selected flash IP</description>
              <bitRange>[9:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--NVRCFG_ADDR: Address Register for NVR_CFG access-->
        <register>
          <name>NVRCFG_ADDR</name>
          <description>Address Register for NVR_CFG access</description>
          <alternateRegister>NVR_ADDR</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ADDRESS: Address value within current sector to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value within current sector to selected flash IP</description>
              <bitRange>[10:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--EXPAND_ADDR: Address Register with expanded fields-->
        <register>
          <name>EXPAND_ADDR</name>
          <description>Address Register with expanded fields</description>
          <alternateRegister>NVRCFG_ADDR</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SECTOR_ADDR: Sector address value to selected flash IP-->
            <field>
              <name>SECTOR_ADDR</name>
              <description>Sector address value to selected flash IP</description>
              <bitRange>[18:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value within current sector to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value within current sector to selected flash IP</description>
              <bitRange>[9:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DATA: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-1</dimIndex>
          <!--end of dimElementGroup-->
          <name>DATA[%s]</name>
          <description>DATA</description>
          <addressOffset>0x10</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Data Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0xffffffff</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Data register value for flash operations-->
              <field>
                <name>VAL</name>
                <description>Data register value for flash operations</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--CMD: Command Register-->
        <register>
          <name>CMD</name>
          <description>Command Register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xc0de0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--KEY: Magic Key for flash access "C0DE"-->
            <field>
              <name>KEY</name>
              <description>Magic Key for flash access "C0DE"</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
              <usage>write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Access</name>
                  <description>magic Key for flash access</description>
                  <value>49374</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--NVRON: NVR access bit-->
            <field>
              <name>NVRON</name>
              <description>NVR access bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--DPD: Enter/Exit power down mode-->
            <field>
              <name>DPD</name>
              <description>Enter/Exit power down mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--ALLSEC: Select all sectors for erase-->
            <field>
              <name>ALLSEC</name>
              <description>Select all sectors for erase</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--ERSEC: Erase sector enable command-->
            <field>
              <name>ERSEC</name>
              <description>Erase sector enable command</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--WR: Write enable command-->
            <field>
              <name>WR</name>
              <description>Write enable command</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RD: Read enable command-->
            <field>
              <name>RD</name>
              <description>Read enable command</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STAT: Status Register-->
        <register>
          <name>STAT</name>
          <description>Status Register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--NVRLOCK: If set NVR_CFG sector of flash is locked-->
            <field>
              <name>NVRLOCK</name>
              <description>If set NVR_CFG sector of flash is locked</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--DPD: Flash IP in powerdown mode-->
            <field>
              <name>DPD</name>
              <description>Flash IP in powerdown mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--IRQF: IRQ Flag set when command done. Set by hardware only if IRQEN bit is set.-->
            <field>
              <name>IRQF</name>
              <description>IRQ Flag set when command done. Set by hardware only if IRQEN bit is set.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--BUSY: Busy status bit when command is processing-->
            <field>
              <name>BUSY</name>
              <description>Busy status bit when command is processing</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CTRL: Control Register-->
        <register>
          <name>CTRL</name>
          <description>Control Register</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--LAT: Flash latency-->
            <field>
              <name>LAT</name>
              <description>Flash latency</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--FBFLUSH: Flush internal buffer-->
            <field>
              <name>FBFLUSH</name>
              <description>Flush internal buffer</description>
              <bitRange>[8:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--IRQEN: Command Interrupt enable bit-->
            <field>
              <name>IRQEN</name>
              <description>Command Interrupt enable bit</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--FBEN: Fetch buffer Enable-->
            <field>
              <name>FBEN</name>
              <description>Fetch buffer Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCETR: Flash Timing Control register (Erase time)-->
        <register>
          <name>FTCETR</name>
          <description>Flash Timing Control register (Erase time)</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xea60</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TSCE: Erase time value in cycles-->
            <field>
              <name>TSCE</name>
              <description>Erase time value in cycles</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCPRT: Flash Timing Control register (Program time)-->
        <register>
          <name>FTCPRT</name>
          <description>Flash Timing Control register (Program time)</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x48201030</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TPROG: Program time value in cycles-->
            <field>
              <name>TPROG</name>
              <description>Program time value in cycles</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPREPGS: PREPG to PROG2 time value in cycles-->
            <field>
              <name>TPREPGS</name>
              <description>PREPG to PROG2 time value in cycles</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPREPROG: Pre-program time value in cycles-->
            <field>
              <name>TPREPROG</name>
              <description>Pre-program time value in cycles</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPGS: Web to PROG2 high time value in cycles-->
            <field>
              <name>TPGS</name>
              <description>Web to PROG2 high time value in cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCERTR: Flash Timing Control register (Erase Recovery time)-->
        <register>
          <name>FTCERTR</name>
          <description>Flash Timing Control register (Erase Recovery time)</description>
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x32000c8</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRCVCHIP: Chip erase recovery time value in cycles-->
            <field>
              <name>TRCVCHIP</name>
              <description>Chip erase recovery time value in cycles</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TRCVSECT: Sector erase recovery time value in cycles-->
            <field>
              <name>TRCVSECT</name>
              <description>Sector erase recovery time value in cycles</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCPRTR: Flash Timing Control register (Program Recovery time)-->
        <register>
          <name>FTCPRTR</name>
          <description>Flash Timing Control register (Program Recovery time)</description>
          <addressOffset>0x10c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x14</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRCVPROG: Program recovery time value in cycles-->
            <field>
              <name>TRCVPROG</name>
              <description>Program recovery time value in cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ERRMASK: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-1</dimIndex>
          <!--end of dimElementGroup-->
          <name>ERRMASK[%s]</name>
          <description>ERRMASK</description>
          <addressOffset>0x170</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Flash Data Mask Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Corresponding bit of 32-bit write data bus is inverted-->
              <field>
                <name>VAL</name>
                <description>Corresponding bit of 32-bit write data bus is inverted</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--FECCCR: Flash ECC Control register-->
        <register>
          <name>FECCCR</name>
          <description>Flash ECC Control register</description>
          <addressOffset>0x180</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ERRINJEN: Enable error injection on write data bus-->
            <field>
              <name>ERRINJEN</name>
              <description>Enable error injection on write data bus</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--IDEUEN: Enable interrupt when double errors detected-->
            <field>
              <name>IDEUEN</name>
              <description>Enable interrupt when double errors detected</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--ISEUEN: Enable interrupt when single error detected-->
            <field>
              <name>ISEUEN</name>
              <description>Enable interrupt when single error detected</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--ECCEN: Enable ECC detect and correction-->
            <field>
              <name>ECCEN</name>
              <description>Enable ECC detect and correction</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCISTAT: Flash ECC Interrupt Status register-->
        <register>
          <name>FECCISTAT</name>
          <description>Flash ECC Interrupt Status register</description>
          <addressOffset>0x184</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DEU: Double error occurred-->
            <field>
              <name>DEU</name>
              <description>Double error occurred</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--SEU: Single error occurred-->
            <field>
              <name>SEU</name>
              <description>Single error occurred</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCSEC: Flash ECC Single Error Counter register-->
        <register>
          <name>FECCSEC</name>
          <description>Flash ECC Single Error Counter register</description>
          <addressOffset>0x190</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Single error times occurred-->
            <field>
              <name>VAL</name>
              <description>Single error times occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCDEC: Flash ECC Double Error Counter register-->
        <register>
          <name>FECCDEC</name>
          <description>Flash ECC Double Error Counter register</description>
          <addressOffset>0x194</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Double error times occurred-->
            <field>
              <name>VAL</name>
              <description>Double error times occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCSEA: Flash ECC Single Error Address register-->
        <register>
          <name>FECCSEA</name>
          <description>Flash ECC Single Error Address register</description>
          <addressOffset>0x198</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Last latched address when single error occurred-->
            <field>
              <name>VAL</name>
              <description>Last latched address when single error occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCDEA: Flash ECC Double Error Address register-->
        <register>
          <name>FECCDEA</name>
          <description>Flash ECC Double Error Address register</description>
          <addressOffset>0x19c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Last latched address when double error occurred-->
            <field>
              <name>VAL</name>
              <description>Last latched address when double error occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--PWM0-->
    <peripheral>
      <name>PWM0</name>
      <version>1.0</version>
      <description>PWM control registers</description>
      <groupName>PWM</groupName>
      <baseAddress>0x5000D000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x9c</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>PWMx_TZ</name>
        <description>PWM TZ combine interrupt</description>
        <value>219</value>
      </interrupt>
      <interrupt>
        <name>PWM0</name>
        <description>PWM0 interrupt</description>
        <value>220</value>
      </interrupt>
      <interrupt>
        <name>PWM0_HD</name>
        <description>PWM0 HD interrupt</description>
        <value>221</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--TBCTL: Time-Base Control Register-->
        <register>
          <name>TBCTL</name>
          <description>Time-Base Control Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x18000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SHDWGLOB: Global enabe for all shadow loads-->
            <field>
              <name>SHDWGLOB</name>
              <description>Global enabe for all shadow loads</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--FREESOFT: Emulation mode bits - select the behavior of the time-base counter during emulation events-->
            <field>
              <name>FREESOFT</name>
              <description>Emulation mode bits - select the behavior of the time-base counter during emulation events</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>StopAtTBCLK</name>
                  <description>stop timer at next TBCLK tact</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>StopAtPeriod</name>
                  <description>stop timer when period ends</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FreeRun</name>
                  <description>free run mode</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--PHSDIR: Phase direction bit-->
            <field>
              <name>PHSDIR</name>
              <description>Phase direction bit</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKDIV: Time-base clock prescale bits-->
            <field>
              <name>CLKDIV</name>
              <description>Time-base clock prescale bits</description>
              <bitRange>[12:10]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Div1</name>
                  <description>clock not divided</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div2</name>
                  <description>clock divided by 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div4</name>
                  <description>clock divided by 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div8</name>
                  <description>clock divided by 8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div16</name>
                  <description>clock divided by 16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div32</name>
                  <description>clock divided by 32</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div64</name>
                  <description>clock divided by 64</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div128</name>
                  <description>clock divided by 128</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--HSPCLKDIV: High speed time-base clock prescale bits-->
            <field>
              <name>HSPCLKDIV</name>
              <description>High speed time-base clock prescale bits</description>
              <bitRange>[9:7]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Div1</name>
                  <description>clock not divided</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div2</name>
                  <description>clock divided by 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div4</name>
                  <description>clock divided by 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div6</name>
                  <description>clock divided by 6</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div8</name>
                  <description>clock divided by 8</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div10</name>
                  <description>clock divided by 10</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div12</name>
                  <description>clock divided by 12</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div14</name>
                  <description>clock divided by 14</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SWFSYNC: Software forced synchronization pulse-->
            <field>
              <name>SWFSYNC</name>
              <description>Software forced synchronization pulse</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--SYNCOSEL: Synchronization Output Select. These bits select the source of the PWM_SYNCO signal.-->
            <field>
              <name>SYNCOSEL</name>
              <description>Synchronization Output Select. These bits select the source of the PWM_SYNCO signal.</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYNCI</name>
                  <description>PWM_SYNCI is source for PWM_SYNCO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqZero</name>
                  <description>CTR = 0000h is source for PWM_SYNCO</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqCMPB</name>
                  <description>CTR = CMPB is source for PWM_SYNCO</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>PWM_SYNCO generation disabled</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--PRDLD: Active period register load from shadow register select-->
            <field>
              <name>PRDLD</name>
              <description>Active period register load from shadow register select</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--PHSEN: Counter register load from phase register enable-->
            <field>
              <name>PHSEN</name>
              <description>Counter register load from phase register enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CTRMODE: Counter mode-->
            <field>
              <name>CTRMODE</name>
              <description>Counter mode</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Up</name>
                  <description>count direction up</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Down</name>
                  <description>count direction down</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UpDown</name>
                  <description>count direction up-down</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Stop</name>
                  <description>counter stopped</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--TBSTS: Time-Base Status Register-->
        <register>
          <name>TBSTS</name>
          <description>Time-Base Status Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CTRMAX: Time-Base counter max latched status bit-->
            <field>
              <name>CTRMAX</name>
              <description>Time-Base counter max latched status bit</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--SYNCI: Input synchronization latched status bit-->
            <field>
              <name>SYNCI</name>
              <description>Input synchronization latched status bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--CTRDIR: Time-Base counter direction status bit-->
            <field>
              <name>CTRDIR</name>
              <description>Time-Base counter direction status bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--TBPHS: Time-Base Phase Register-->
        <register>
          <name>TBPHS</name>
          <description>Time-Base Phase Register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TBPHS: Time-base counter phase-->
            <field>
              <name>TBPHS</name>
              <description>Time-base counter phase</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TBPHSHR: Time-base counter phase in High-Resolution mode-->
            <field>
              <name>TBPHSHR</name>
              <description>Time-base counter phase in High-Resolution mode</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TBCTR: Time-Base Counter Register-->
        <register>
          <name>TBCTR</name>
          <description>Time-Base Counter Register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Current time-base counter value-->
            <field>
              <name>VAL</name>
              <description>Current time-base counter value</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TBPRD: Time-Base Period Register-->
        <register>
          <name>TBPRD</name>
          <description>Time-Base Period Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Period of the time-base counter-->
            <field>
              <name>VAL</name>
              <description>Period of the time-base counter</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CMPCTL: Counter-Compare Control Register-->
        <register>
          <name>CMPCTL</name>
          <description>Counter-Compare Control Register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SHDWBFULL: CMPB shadow register full status flag-->
            <field>
              <name>SHDWBFULL</name>
              <description>CMPB shadow register full status flag</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <!--SHDWAFULL: CMPA shadow register full status flag-->
            <field>
              <name>SHDWAFULL</name>
              <description>CMPA shadow register full status flag</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--SHDWBMODE: CMPB register operating mode-->
            <field>
              <name>SHDWBMODE</name>
              <description>CMPB register operating mode</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--SHDWAMODE: CMPA register operating mode-->
            <field>
              <name>SHDWAMODE</name>
              <description>CMPA register operating mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--LOADBMODE: Active CMPB load from shadow select mode-->
            <field>
              <name>LOADBMODE</name>
              <description>Active CMPB load from shadow select mode</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CTREqZero</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqPRD</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = PRD</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqZeroPRD</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = 0 or CTR = PRD</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>shadow load for CMPx (x=A,B) disabled</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--LOADAMODE: Active CMPA load from shadow select mode-->
            <field>
              <name>LOADAMODE</name>
              <description>Active CMPA load from shadow select mode</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CTREqZero</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqPRD</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = PRD</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqZeroPRD</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = 0 or CTR = PRD</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>shadow load for CMPx (x=A,B) disabled</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--CMPA: Counter-Compare A Register-->
        <register>
          <name>CMPA</name>
          <description>Counter-Compare A Register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CMPA: The value compared to the time-base counter (TBCTR)-->
            <field>
              <name>CMPA</name>
              <description>The value compared to the time-base counter (TBCTR)</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--CMPAHR: The value compared to the time-base counter (TBCTR) in High-Resolution mode-->
            <field>
              <name>CMPAHR</name>
              <description>The value compared to the time-base counter (TBCTR) in High-Resolution mode</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CMPB: Counter-Compare B Register-->
        <register>
          <name>CMPB</name>
          <description>Counter-Compare B Register</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

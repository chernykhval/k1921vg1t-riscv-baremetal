                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <!--RSTADC: Reset ADC module-->
              <field>
                <name>RSTADC</name>
                <description>Reset ADC module</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <!--SELRES: ADC resolution select-->
              <field>
                <name>SELRES</name>
                <description>ADC resolution select</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>6bit</name>
                    <description>6 bit mode</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>8bit</name>
                    <description>8 bit mode</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>10bit</name>
                    <description>10 bit mode</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>12bit</name>
                    <description>12 bit mode</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <!--SEL: Select channel for testing-->
              <field>

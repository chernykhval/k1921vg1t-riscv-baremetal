    <!--CANFD0-->
    <peripheral>
      <name>CANFD0</name>
      <version>1.0</version>
      <description>CANFD control registers</description>
      <groupName>CANFD</groupName>
      <baseAddress>0x41000000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>CANFD0</name>
        <description>CANFD0 interrupt</description>
        <value>170</value>
      </interrupt>
      <interrupt>
        <name>CANFD0_TIMER</name>
        <description>CANFD0 Timer interrupt</description>
        <value>171</value>
      </interrupt>
      <interrupt>
        <name>CANFD0_ECC</name>
        <description>CANFD0 ECC Single/Double Error detection interrupt</description>
        <value>172</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CONTROL: CAN General Control Register-->
        <register>
          <name>CONTROL</name>
          <description>CAN General Control Register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ABRQ: Break request-->
            <field>
              <name>ABRQ</name>
              <description>Break request</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--OVRQ: Request for overrun frame-->
            <field>
              <name>OVRQ</name>

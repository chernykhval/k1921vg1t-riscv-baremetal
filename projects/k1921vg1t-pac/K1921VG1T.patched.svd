        <!--TMRMUX: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-15</dimIndex>
          <!--end of dimElementGroup-->
          <name>TMRMUX[%s]</name>
          <description>TMRMUX</description>
          <addressOffset>0x70</addressOffset>
          <register>
            <name>VALUE</name>
            <description>TMRxx ccix input select (0-3 array consist of full 32 bit register, 4-16 only CCI*_0)</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--CCIB_3: Select signal for TMRxx CCIB 3 input-->
              <field>
                <name>CCIB_3</name>
                <description>Select signal for TMRxx CCIB 3 input</description>
                <bitRange>[31:28]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>TMRIO0</name>
                    <description>External pin</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TMRIO1</name>
                    <description>External pin</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TMRIO2</name>
                    <description>External pin</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TMRIO3</name>
                    <description>External pin</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GPIOAB</name>
                    <description>GPIOA or GPIOB adc soc impulse</description>
                    <value>4</value>
                  </enumeratedValue>

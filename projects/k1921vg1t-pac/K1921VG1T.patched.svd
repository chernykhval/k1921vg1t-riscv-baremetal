          <dimIncrement>16</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>CAPCOM[%s]</name>
          <description>CAPCOM</description>
          <addressOffset>0x100</addressOffset>
          <register>
            <name>CTRL</name>
            <description>Capture / Compare Control register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x20</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--CAPMODE: Capture Mode-->
              <field>
                <name>CAPMODE</name>
                <description>Capture Mode</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
              </field>
              <!--CCISEL: Capture / Compare Input Select-->
              <field>
                <name>CCISEL</name>
                <description>Capture / Compare Input Select</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <!--SCCI: Synchronized Capture / Compare Input-->
              <field>
                <name>SCCI</name>
                <description>Synchronized Capture / Compare Input</description>
                <bitRange>[10:10]</bitRange>
                <access>read-only</access>
              </field>
              <!--CAP: Capture Mode-->
              <field>
                <name>CAP</name>
                <description>Capture Mode</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <!--OUTMODE: Output Mode-->
              <field>
                <name>OUTMODE</name>
                <description>Output Mode</description>
                <bitRange>[7:5]</bitRange>
                <access>read-write</access>
              </field>
              <!--CCI: Capture / Compare Input-->
              <field>
                <name>CCI</name>
                <description>Capture / Compare Input</description>
                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
              <!--OUT: Output-->
              <field>
                <name>OUT</name>
                <description>Output</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <!--OVF: Capture Overflow-->
              <field>
                <name>OVF</name>
                <description>Capture Overflow</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>VAL0</name>
            <description>Capture/Compare Value 0 register</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: -->
              <field>
                <name>VAL</name>
                <description />
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>VAL1</name>
            <description>Capture/Compare Value 1 register</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: -->
              <field>
                <name>VAL</name>
                <description />
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>Reserved</name>
            <description />
            <addressOffset>0xc</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
          </register>
        </cluster>
      </registers>
    </peripheral>

          <resetValue>0x10102</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--READY: Ready to update DATA-->
            <field>
              <name>READY</name>
              <description>Ready to update DATA</description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
            </field>
            <!--BUF_VREF: VREF Input Buffer Control: 1 - buffered (Vref = 0.04..Vdd-0.04); 0 - unbuffered (Vref = 0..Vdd)-->
            <field>
              <name>BUF_VREF</name>
              <description>VREF Input Buffer Control: 1 - buffered (Vref = 0.04..Vdd-0.04); 0 - unbuffered (Vref = 0..Vdd)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--NOT_GAIN: Not gain output: 1 - 1x (Vout = Vref * DATA / 4096); 0 - 2x (Vout = 2 * Vref * DATA / 4096);-->
            <field>
              <name>NOT_GAIN</name>
              <description>Not gain output: 1 - 1x (Vout = Vref * DATA / 4096); 0 - 2x (Vout = 2 * Vref * DATA / 4096);</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--SCLK_DIV: SPI SCLK divider. SCLK period = (SCLK_DIV + 1) * 1-->
            <field>
              <name>SCLK_DIV</name>
              <description>SPI SCLK divider. SCLK period = (SCLK_DIV + 1) * 1</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

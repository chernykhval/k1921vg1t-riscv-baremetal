                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqZero</name>
                  <description>generate PWM_SOCA/PWM_SOCB/PWN_INT impulse on CTR = 0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqPRD</name>
                  <description>generate PWM_SOCA/PWM_SOCB/PWN_INT impulse on CTR = PRD</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqCMPB</name>
                  <description>generate PWM_SOCA/PWM_SOCB/PWN_INT impulse on CTR = CMPB</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqCMPA_OnUp</name>
                  <description>generate PWM_SOCA/PWM_SOCB/PWN_INT impulse on CTR = CMPA when count up</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqCMPA_OnDown</name>
                  <description>generate PWM_SOCA/PWM_SOCB/PWN_INT impulse on CTR = CMPA when count down</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqCMPB_OnUp</name>
                  <description>generate PWM_SOCA/PWM_SOCB/PWN_INT impulse on CTR = CMPB when count up</description>
                  <value>6</value>

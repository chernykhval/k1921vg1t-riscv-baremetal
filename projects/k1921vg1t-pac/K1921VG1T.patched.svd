        <!--ETPS: Event-Trigger Prescale Register-->
        <register>
          <name>ETPS</name>
          <description>Event-Trigger Prescale Register</description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DRQBCNT: PWM DMA request event B counter-->
            <field>
              <name>DRQBCNT</name>
              <description>PWM DMA request event B counter</description>
              <bitRange>[23:22]</bitRange>
              <access>read-only</access>
            </field>
            <!--DRQBPRD: PWM DMA request B period select-->
            <field>
              <name>DRQBPRD</name>
              <description>PWM DMA request B period select</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--DRQACNT: PWM DMA request event A counter-->

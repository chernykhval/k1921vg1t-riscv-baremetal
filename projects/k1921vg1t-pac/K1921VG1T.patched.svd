              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--TFIC: Tx FIFO  Full  Interrupt Clear-->
            <field>
              <name>TFIC</name>
              <description>Tx FIFO  Full  Interrupt Clear</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--TEIC: Tx FIFO  Empty Interrupt Clear-->
            <field>
              <name>TEIC</name>
              <description>Tx FIFO  Empty Interrupt Clear</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--TSIC: Transfer Stall Interrupt Clear-->
            <field>
              <name>TSIC</name>
              <description>Transfer Stall Interrupt Clear</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--TCIC: Transfer Complete Interrupt Clear-->
            <field>
              <name>TCIC</name>
              <description>Transfer Complete Interrupt Clear</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--RIS: Raw Interrupt Status Register-->
        <register>
          <name>RIS</name>
          <description>Raw Interrupt Status Register</description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RWMRIS: Rx FIFO Watermark raw interrupt status-->
            <field>
              <name>RWMRIS</name>
              <description>Rx FIFO Watermark raw interrupt status</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <!--TWMRIS: Tx FIFO Watermark raw interrupt status-->
            <field>
              <name>TWMRIS</name>
              <description>Tx FIFO Watermark raw interrupt status</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--RFRIS: Rx FIFO Full raw interrupt status-->
            <field>
              <name>RFRIS</name>
              <description>Rx FIFO Full raw interrupt status</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <!--RERIS: Rx FIFO Empty raw interrupt status-->
            <field>
              <name>RERIS</name>
              <description>Rx FIFO Empty raw interrupt status</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <!--TFRIS: Tx FIFO Full raw interrupt status-->
            <field>
              <name>TFRIS</name>
              <description>Tx FIFO Full raw interrupt status</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <!--TERIS: Tx FIFO Empty raw interrupt status-->
            <field>
              <name>TERIS</name>
              <description>Tx FIFO Empty raw interrupt status</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--TSRIS: Transfer Stall raw interrupt status-->
            <field>
              <name>TSRIS</name>
              <description>Transfer Stall raw interrupt status</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--TCRIS: Transfer Complete raw interrupt status-->
            <field>
              <name>TCRIS</name>
              <description>Transfer Complete raw interrupt status</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--FWM: Fifo's WaterMarks Register-->
        <register>
          <name>FWM</name>
          <description>Fifo's WaterMarks Register</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xe02</resetValue>

                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIOCD</name>
                  <description>GPIO C or GPIO D interrupt</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIOEF</name>
                  <description>GPIO E or GPIO F interrupt</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIOG</name>
                  <description>GPIO G interrupt</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWMAGRP</name>
                  <description>Combined all 16 A channels of PWMs</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWMBGRP</name>
                  <description>Combined all 16 B channels of PWMs</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reserved0</name>
                  <description>Reserved</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reserved1</name>
                  <description>Reserved</description>

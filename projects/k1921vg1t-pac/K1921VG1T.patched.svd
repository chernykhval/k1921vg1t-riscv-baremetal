      <registers>
        <!-- -->
        <!--FDR: Fractional divider register-->
        <register>
          <name>FDR</name>
          <description>Fractional divider register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RESULT: Count frequency divider-->
            <field>
              <name>RESULT</name>
              <description>Count frequency divider</description>
              <bitRange>[25:16]</bitRange>
              <access>read-only</access>
            </field>
            <!--MODE: Mode setting of the frequency divider-->
            <field>
              <name>MODE</name>
              <description>Mode setting of the frequency divider</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TURN_OFF</name>
                  <description>Divider is turned off. Fmsc isn't generated</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>Normal divider mod is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FRACTIONAL</name>
                  <description>Fractional divider mode is selected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BYPASS</name>
                  <description>Bypass mode is selected (Fmsc = Fapb / 2)</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--STEP: Divider start value in the normal mode / Step of divider in the fractional mode-->
            <field>
              <name>STEP</name>
              <description>Divider start value in the normal mode / Step of divider in the fractional mode</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

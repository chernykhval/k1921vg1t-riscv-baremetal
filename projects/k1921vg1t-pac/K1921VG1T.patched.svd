              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--IMR: Interrupt enable register-->
        <register>
          <name>IMR</name>
          <description>Interrupt enable register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DCIE: Digest calculation completion interrupt enable-->
            <field>
              <name>DCIE</name>
              <description>Digest calculation completion interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--DINIE: Data input interrupt enable-->
            <field>
              <name>DINIE</name>
              <description>Data input interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--SR: Interrupt status register-->
        <register>
          <name>SR</name>
          <description>Interrupt status register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BUSY: Busy bit-->
            <field>
              <name>BUSY</name>
              <description>Busy bit</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <!--DMAS: DMA status-->
            <field>
              <name>DMAS</name>
              <description>DMA status</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--DCIS: Digest calculation completion interrupt status-->
            <field>
              <name>DCIS</name>
              <description>Digest calculation completion interrupt status</description>
              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
            </field>
            <!--DINIS: Data input interrupt status-->
            <field>
              <name>DINIS</name>
              <description>Data input interrupt status</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--HR: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-7</dimIndex>
          <!--end of dimElementGroup-->
          <name>HR[%s]</name>
          <description>HR</description>

              <name>POR</name>
              <description>PowerOn Reset status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--BORCFG: Broun-Out Reset Configuration register-->
        <register>
          <name>BORCFG</name>
          <description>Broun-Out Reset Configuration register</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

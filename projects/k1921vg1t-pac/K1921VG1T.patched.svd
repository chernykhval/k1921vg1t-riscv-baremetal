            <field>
              <name>DRQBSEL</name>
              <description>PWM B DMA request event selection</description>
              <bitRange>[22:20]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CTREqCMPA</name>

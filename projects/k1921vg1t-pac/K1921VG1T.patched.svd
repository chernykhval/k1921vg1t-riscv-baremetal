    <!--USBCTR0-->
    <peripheral>
      <name>USBCTR0</name>
      <version>1.0</version>
      <description>USB common registers</description>
      <groupName>USBCTR</groupName>
      <baseAddress>0x41080800</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>USB0</name>
        <description>USB0 interrupt</description>
        <value>164</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--HOSTEN: USB Host Enable register-->
        <register>
          <name>HOSTEN</name>
          <description>USB Host Enable register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--HOSTEN: Congifure USB output as a host-->
            <field>
              <name>HOSTEN</name>
              <description>Congifure USB output as a host</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PHYSTAT: USB PHY Layer Status register-->
        <register>
          <name>PHYSTAT</name>
          <description>USB PHY Layer Status register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--POL: Polarity-->
            <field>
              <name>POL</name>
              <description>Polarity</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <!--RECEIVE_EN: Receiver status in digital part of phy-->
            <field>
              <name>RECEIVE_EN</name>
              <description>Receiver status in digital part of phy</description>
              <bitRange>[30:30]</bitRange>
              <access>read-only</access>
            </field>
            <!--RX_LSFS_EN: RX_LSFS_EN signal status-->
            <field>
              <name>RX_LSFS_EN</name>
              <description>RX_LSFS_EN signal status</description>
              <bitRange>[29:29]</bitRange>
              <access>read-only</access>
            </field>
            <!--RX_SE_EN: RX_SE_EN signal status-->
            <field>
              <name>RX_SE_EN</name>
              <description>RX_SE_EN signal status</description>
              <bitRange>[28:28]</bitRange>
              <access>read-only</access>
            </field>
            <!--TX_LSFS_EN: TX_LSFS_EN signal status-->
            <field>
              <name>TX_LSFS_EN</name>
              <description>TX_LSFS_EN signal status</description>
              <bitRange>[27:27]</bitRange>
              <access>read-only</access>
            </field>
            <!--EN_RPU: EN_RPU signal status-->
            <field>
              <name>EN_RPU</name>
              <description>EN_RPU signal status</description>
              <bitRange>[25:25]</bitRange>
              <access>read-only</access>
            </field>
            <!--OPMODE: OPMODE bus status-->
            <field>
              <name>OPMODE</name>
              <description>OPMODE bus status</description>
              <bitRange>[24:23]</bitRange>
              <access>read-only</access>
            </field>
            <!--XCVRSELECT: XCVRSELECT bus status-->
            <field>
              <name>XCVRSELECT</name>
              <description>XCVRSELECT bus status</description>
              <bitRange>[22:21]</bitRange>
              <access>read-only</access>
            </field>
            <!--HST_DISC: HOST_DISCONNECT signal status-->
            <field>
              <name>HST_DISC</name>
              <description>HOST_DISCONNECT signal status</description>
              <bitRange>[20:20]</bitRange>
              <access>read-only</access>
            </field>
            <!--TERMSELECT: TERMSELECT signal status-->
            <field>
              <name>TERMSELECT</name>
              <description>TERMSELECT signal status</description>
              <bitRange>[19:19]</bitRange>
              <access>read-only</access>
            </field>
            <!--SUSPENDM: SUSPENDM signal status-->
            <field>
              <name>SUSPENDM</name>
              <description>SUSPENDM signal status</description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
            </field>
            <!--RESET: RESET signal status-->
            <field>
              <name>RESET</name>
              <description>RESET signal status</description>
              <bitRange>[17:17]</bitRange>
              <access>read-only</access>
            </field>
            <!--PD_PLL_REQ: PD_PLL_REQ signal status-->
            <field>
              <name>PD_PLL_REQ</name>
              <description>PD_PLL_REQ signal status</description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
            </field>
            <!--PLL_LOCK: PLL_LOCK signal status-->
            <field>
              <name>PLL_LOCK</name>
              <description>PLL_LOCK signal status</description>
              <bitRange>[15:15]</bitRange>
              <access>read-only</access>
            </field>
            <!--UTMI_CLK_EN: Clock out signal present on UTMI interface-->
            <field>
              <name>UTMI_CLK_EN</name>
              <description>Clock out signal present on UTMI interface</description>
              <bitRange>[13:13]</bitRange>
              <access>read-only</access>
            </field>
            <!--RS_LOCKED: RSOURCE_LOCKED output status-->
            <field>
              <name>RS_LOCKED</name>
              <description>RSOURCE_LOCKED output status</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <!--ROUT_LOCKED: ROUT_LOCKED output status-->
            <field>
              <name>ROUT_LOCKED</name>
              <description>ROUT_LOCKED output status</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
            </field>
            <!--RSET_CODE: CREF_RSOURCE_CODE - setting resistor tune code value-->
            <field>
              <name>RSET_CODE</name>
              <description>CREF_RSOURCE_CODE - setting resistor tune code value</description>
              <bitRange>[7:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--ROUT_CODE: TX_ROUT_CODE - transmitter output resistor tune code value-->
            <field>
              <name>ROUT_CODE</name>
              <description>TX_ROUT_CODE - transmitter output resistor tune code value</description>
              <bitRange>[3:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--PHYCFG0: USB Physical Layer Config 0 register-->
        <register>
          <name>PHYCFG0</name>
          <description>USB Physical Layer Config 0 register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DTPSEL: DTP select-->
            <field>
              <name>DTPSEL</name>
              <description>DTP select</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Internal analog mux is power off</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ODT_COMP_OUT</name>
                  <description>dtp connects to comparator output in calibration block</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ODT_EN</name>
                  <description>dtp connects to calibration block enable signal</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RX_SE_DP</name>
                  <description>dtp connects to DP output of the receiver</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RX_SE_DM</name>
                  <description>dtp connects to DM output of the receiver</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RX_LSFS_SDATA</name>
                  <description>dtp connects to diff output of the receiver</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CREF_EN</name>
                  <description>dtp connects to enable signal of bias current source</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN_RPU</name>
                  <description>dtp connect RPU resistor</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN_RPU_LOW</name>
                  <description>dtp connect RPU resistor</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TX_SDATA</name>
                  <description>dtp connects to transmitter data</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TX_LSFS_EN</name>
                  <description>dtp connects to enable transmitter signal</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TX_LSFS_OEB</name>
                  <description>dtp connects to output enable signal of the transmitter</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TX_LSFS_SE0</name>
                  <description>dtp connects to SE0</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RX_SE_EN</name>
                  <description>dtp connects to enable receiver signal</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RX_LSFS_EN</name>
                  <description>dtp connects to receiver enable signal</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EBUF_VALID</name>
                  <description>dtp connects to compensation buffer ready signal</description>
                  <value>15</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EBUF_ERROR</name>
                  <description>dtp connects to compensation buffer error signal</description>
                  <value>16</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYNC</name>
                  <description>dtp connects to SYNC pattern detector</description>
                  <value>17</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EOP</name>
                  <description>dtp connects to EOP pattern detector</description>
                  <value>18</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESET</name>
                  <description>dtp connects to reset signal</description>
                  <value>19</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLLLOCK</name>
                  <description>dtp connects to pll lock signal</description>
                  <value>20</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RXACTIVE</name>
                  <description>dtp connects to RXActive signal</description>
                  <value>21</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RXERROR</name>
                  <description>dtp connects tp RXError signal</description>
                  <value>22</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--ATPSEL: ATP select-->
            <field>
              <name>ATPSEL</name>
              <description>ATP select</description>
              <bitRange>[6:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Internal analog mux is power off</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COMP_VR</name>
                  <description>atp_0 connects to ground and atp_1 connects to comp_vr from calibration block</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COMP_VREF</name>
                  <description>atp_0 connects to ground and atp_1 connects to comp_vref from calibration block</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VDDH</name>
                  <description>atp_0 connects to ground and atp_1 connects to VDDH</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--POL: Polarity-->
            <field>
              <name>POL</name>
              <description>Polarity</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--EXTPHY: Use external PHY Layer-->
            <field>
              <name>EXTPHY</name>
              <description>Use external PHY Layer</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PHYCFG1: USB Physical Layer Config 1 register-->
        <register>
          <name>PHYCFG1</name>
          <description>USB Physical Layer Config 1 register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TUNE_EN: Tune enable-->
            <field>
              <name>TUNE_EN</name>
              <description>Tune enable</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <!--RPUMODE: RPU compensation mode-->
            <field>
              <name>RPUMODE</name>
              <description>RPU compensation mode</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEFAULT</name>
                  <description>Default value</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reserved</name>
                  <description>Reserved value</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>TX_RPU_COMP_EN always 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HIGH</name>
                  <description>TX_RPU_COMP_EN always 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TX_MODE: Transmitter mode-->
            <field>
              <name>TX_MODE</name>
              <description>Transmitter mode</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <!--CREFSEL: Select type of bsae current-->
            <field>
              <name>CREFSEL</name>
              <description>Select type of bsae current</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--FORCE_RX: Debug signal: do not shut off receiver when the packet has come-->
            <field>
              <name>FORCE_RX</name>
              <description>Debug signal: do not shut off receiver when the packet has come</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <!--DLL_PHASE: Capture point in bit interval-->
            <field>
              <name>DLL_PHASE</name>
              <description>Capture point in bit interval</description>
              <bitRange>[14:13]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PERCENT_80</name>
                  <description>80% of bit interval</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PERCENT_40</name>
                  <description>40% of bit interval</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PERCENT_60</name>
                  <description>60% of bit interval</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PERCENT_100</name>
                  <description>100% of bit interval</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--RSET_TUNE_EN: Automatic calibration of resistor in current source-->
            <field>
              <name>RSET_TUNE_EN</name>
              <description>Automatic calibration of resistor in current source</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--RSET_CODE: Setting resistor tune code-->
            <field>
              <name>RSET_CODE</name>
              <description>Setting resistor tune code</description>
              <bitRange>[8:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--ROUT_TUNE_EN: Automatic transmitter output resistor calibration-->
            <field>
              <name>ROUT_TUNE_EN</name>
              <description>Automatic transmitter output resistor calibration</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--ROUT_CODE: Transmitter output resistor tune code-->
            <field>
              <name>ROUT_CODE</name>
              <description>Transmitter output resistor tune code</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

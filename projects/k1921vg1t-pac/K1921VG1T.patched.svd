              <field>
                <name>CMD_SET_INT</name>
                <description>Set interrupt after the entire buffer has been transferred</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>STATIC0</name>
            <description>Static register 0</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x80010000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--RD_INCR: Increment next burst address-->
              <field>
                <name>RD_INCR</name>
                <description>Increment next burst address</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
              <!--RD_OUTSTCFG: Channel cfg: Use AXI read command when FIFO is full - Not implemented-->
              <field>

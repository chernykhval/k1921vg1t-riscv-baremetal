            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--END_SWAP: Endiannes byte swapping-->
              <field>
                <name>END_SWAP</name>
                <description>Endiannes byte swapping</description>
                <bitRange>[29:28]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NO_SWAP</name>
                    <description>No swapping</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SWAP_WITHIN16bits</name>
                    <description>Swap bytes within 16 bits</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SWAP_WITHIN32bits</name>
                    <description>Swap bytes within 32 bits</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RESERVED</name>
                    <description>Reserved</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <!--RETRY: If set the channel will automatically retry transfer if overflow or underflow occurs - Not implemented-->
              <field>
                <name>RETRY</name>
                <description>If set the channel will automatically retry transfer if overflow or underflow occurs - Not implemented</description>
                <bitRange>[17:17]</bitRange>
                <access>read-only</access>
              </field>
              <!--JOINT: Channel works in joint mode-->
              <field>
                <name>JOINT</name>
                <description>Channel works in joint mode</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--BLOCK: Work in block mode - Not Implemented-->
              <field>
                <name>BLOCK</name>

                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>REFCLK</name>
                    <description>HSI 4MHz if CPE=0 or HSE(XTALL) if CPE=1</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SRCCLK</name>
                    <description>HSE(XTALL) if CPE=0 or HSI 4MHz if CPE=1</description>

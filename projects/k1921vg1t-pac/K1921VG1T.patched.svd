    <peripheral>
      <name>GPIOA</name>
      <version>1.0</version>
      <description>GPIO control registers</description>
      <groupName>GPIO</groupName>
      <baseAddress>0x40000000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0xc00</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>GPIOA</name>
        <description>GPIO A interrupt</description>
        <value>8</value>
      </interrupt>

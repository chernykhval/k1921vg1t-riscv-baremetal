                <bitRange>[27:24]</bitRange>
                <access>read-write</access>
              </field>
              <!--RD_TOKENS: Number of AXI read commands to issue before the channel releases the AXI command bus-->
              <field>
                <name>RD_TOKENS</name>
                <description>Number of AXI read commands to issue before the channel releases the AXI command bus</description>
                <bitRange>[21:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--RD_BURST_MAX: Maximum number of bytes of an AXI read burst-->
              <field>
                <name>RD_BURST_MAX</name>
                <description>Maximum number of bytes of an AXI read burst</description>
                <bitRange>[6:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>STATIC1</name>
            <description>Static register 1</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x80010000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--WR_INCR: Increment next burst address-->
              <field>
                <name>WR_INCR</name>
                <description>Increment next burst address</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
              <!--WR_OUTSTCFG: Channel cfg: Use AXI write command when FIFO is full - Not implemented-->
              <field>
                <name>WR_OUTSTCFG</name>
                <description>Channel cfg: Use AXI write command when FIFO is full - Not implemented</description>
                <bitRange>[30:30]</bitRange>
                <access>read-only</access>
              </field>
              <!--WR_OUTS_MAX: Number of maximum outstanding AXI write commands-->
              <field>
                <name>WR_OUTS_MAX</name>
                <description>Number of maximum outstanding AXI write commands</description>
                <bitRange>[27:24]</bitRange>
                <access>read-write</access>
              </field>
              <!--WR_TOKENS: Number of AXI write commands to issue before the channel releases the AXI command bus-->
              <field>
                <name>WR_TOKENS</name>
                <description>Number of AXI write commands to issue before the channel releases the AXI command bus</description>
                <bitRange>[21:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--WR_BURST_MAX: Maximum number of bytes of an AXI write burst-->
              <field>
                <name>WR_BURST_MAX</name>
                <description>Maximum number of bytes of an AXI write burst</description>
                <bitRange>[6:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>STATIC2</name>
            <description>Static register 2</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>

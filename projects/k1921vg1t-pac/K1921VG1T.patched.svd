                <name>RD_ALLOWFIFO</name>
                <description>Read start address does not restrict burst size</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>RDOFFSET</name>

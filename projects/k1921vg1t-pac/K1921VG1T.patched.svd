                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
              <!--WR_OUTSTAND: Write outstanding is currently active-->
              <field>
                <name>WR_OUTSTAND</name>
                <description>Write outstanding is currently active</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
              <!--RD_OUTSTAND: Read outstanding is currently active-->
              <field>
                <name>RD_OUTSTAND</name>
                <description>Read outstanding is currently active</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>

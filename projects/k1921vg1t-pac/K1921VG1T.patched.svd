                  <description>PWMA/PWMB go to 0 on failture</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NoAction</name>
                  <description>no action on failture</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--HDA: Action when hold detection A is invoked-->
            <field>
              <name>HDA</name>
              <description>Action when hold detection A is invoked</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Set</name>
                  <description>PWMA/PWMB go to 1 on failture</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>PWMA/PWMB go to 0 on failture</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NoAction</name>
                  <description>no action on failture</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--HDEINT: Hold Detector Enable Interrupt Register-->
        <register>
          <name>HDEINT</name>
          <description>Hold Detector Enable Interrupt Register</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OST: Hold detector One-Shot interrupt enable-->
            <field>
              <name>OST</name>
              <description>Hold detector One-Shot interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CBC: Hold detector Cycle-by-Cycle interrupt enable-->
            <field>
              <name>CBC</name>
              <description>Hold detector Cycle-by-Cycle interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--HDFLG: Hold Detector Flag Register-->
        <register>
          <name>HDFLG</name>
          <description>Hold Detector Flag Register</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OST: Latched status flag for hold detector One-Shot event-->
            <field>
              <name>OST</name>
              <description>Latched status flag for hold detector One-Shot event</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--CBC: Latched status flag for hold detector Cycle-by-Cycle event-->
            <field>
              <name>CBC</name>
              <description>Latched status flag for hold detector Cycle-by-Cycle event</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <!--INT: Latched hold detector interrupt status flag-->
            <field>
              <name>INT</name>
              <description>Latched hold detector interrupt status flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--HDCLR: Register clear HD flag-->
        <register>
          <name>HDCLR</name>
          <description>Register clear HD flag</description>
          <addressOffset>0x88</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OST: Clear flag for One-Shot hold detector latch-->
            <field>
              <name>OST</name>
              <description>Clear flag for One-Shot hold detector latch</description>
              <bitRange>[2:2]</bitRange>
              <access>write-only</access>
            </field>
            <!--CBC: Clear flag for Cycle-By-Cycle hold detector latch-->
            <field>
              <name>CBC</name>
              <description>Clear flag for Cycle-By-Cycle hold detector latch</description>
              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
            </field>
            <!--INT: Clear hold detector interrupt flag-->
            <field>
              <name>INT</name>
              <description>Clear hold detector interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--HDFRC: Hold Detector Force Register-->
        <register>
          <name>HDFRC</name>
          <description>Hold Detector Force Register</description>
          <addressOffset>0x8c</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OST: Force a One-Shot hold detector event via software-->
            <field>
              <name>OST</name>
              <description>Force a One-Shot hold detector event via software</description>
              <bitRange>[2:2]</bitRange>
              <access>write-only</access>
            </field>
            <!--CBC: Force a Cycle-by-Cycle hold detector event via software-->
            <field>
              <name>CBC</name>
              <description>Force a Cycle-by-Cycle hold detector event via software</description>
              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--HDINTCLR: Hold Detector Interrupt pending Clear Register-->
        <register>
          <name>HDINTCLR</name>
          <description>Hold Detector Interrupt pending Clear Register</description>
          <addressOffset>0x90</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--INT: Clear HD interrupt pending-->
            <field>
              <name>INT</name>
              <description>Clear HD interrupt pending</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--TZINTCLR: Trip-Zone Interrupt pending Clear Register-->
        <register>
          <name>TZINTCLR</name>
          <description>Trip-Zone Interrupt pending Clear Register</description>
          <addressOffset>0x94</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--INT: Clear TZ interrupt pending-->
            <field>
              <name>INT</name>
              <description>Clear TZ interrupt pending</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--INTCLR: PWM Interrupt pending Clear Register-->
        <register>
          <name>INTCLR</name>
          <description>PWM Interrupt pending Clear Register</description>
          <addressOffset>0x98</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--INT: Clear interrupt pending-->
            <field>
              <name>INT</name>
              <description>Clear interrupt pending</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

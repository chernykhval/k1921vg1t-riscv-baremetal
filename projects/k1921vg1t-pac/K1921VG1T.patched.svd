                <enumeratedValue>
                  <name>UNSIGNED</name>
                  <description>Data treated as unsigned value</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIGNED</name>
                  <description>Data treated as signed values</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DATAMODE: Switch between independent and simultaneous DAC mode-->
            <field>
              <name>DATAMODE</name>

              <field>
                <name>ALLOW_JBURST</name>
                <description>Joint bursts are currently active</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <!--ALLOW_FBURST: Maximum bursts of 16 strobes can be used-->
              <field>
                <name>ALLOW_FBURST</name>
                <description>Maximum bursts of 16 strobes can be used</description>
                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
              <!--ALLOW_FIFO: Burst size can equal data buffer size-->
              <field>

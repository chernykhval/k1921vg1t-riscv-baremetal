              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--CBC4: Cycle-by-Cycle  trip-zone 4 enable-->
            <field>
              <name>CBC4</name>
              <description>Cycle-by-Cycle  trip-zone 4 enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--CBC3: Cycle-by-Cycle  trip-zone 3 enable-->
            <field>
              <name>CBC3</name>

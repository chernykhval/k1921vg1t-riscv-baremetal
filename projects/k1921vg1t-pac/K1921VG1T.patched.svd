    <!--FLASHM-->
    <peripheral>
      <name>FLASHM</name>
      <version>1.0</version>
      <description>Flash control registers</description>
      <groupName>FLASHM</groupName>
      <baseAddress>0x50002000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1a0</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>FLASH</name>
        <description>FLASH (main array and data array) combine interrupt</description>
        <value>4</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--ADDR: Address Register-->
        <register>
          <name>ADDR</name>
          <description>Address Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BANK: Address value for flash operations (Bank number)-->
            <field>
              <name>BANK</name>
              <description>Address value for flash operations (Bank number)</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value to selected flash IP</description>
              <bitRange>[19:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--NVR_ADDR: Address Register for NVR access-->
        <register>
          <name>NVR_ADDR</name>
          <description>Address Register for NVR access</description>
          <alternateRegister>ADDR</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BANK: Address value for flash operations (Bank number)-->
            <field>
              <name>BANK</name>
              <description>Address value for flash operations (Bank number)</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--HIGH_SECTOR: Sector address value (msb) to selected flash IP-->
            <field>
              <name>HIGH_SECTOR</name>
              <description>Sector address value (msb) to selected flash IP</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <!--SECTOR_ADDR: Sector address value (lsb) to selected flash IP-->
            <field>
              <name>SECTOR_ADDR</name>
              <description>Sector address value (lsb) to selected flash IP</description>
              <bitRange>[13:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value within current sector to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value within current sector to selected flash IP</description>
              <bitRange>[10:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--NVRCFG_ADDR: Address Register for NVR_CFG access-->
        <register>
          <name>NVRCFG_ADDR</name>
          <description>Address Register for NVR_CFG access</description>
          <alternateRegister>NVR_ADDR</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BANK: Address value for flash operations (Bank number)-->
            <field>
              <name>BANK</name>
              <description>Address value for flash operations (Bank number)</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value within current sector to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value within current sector to selected flash IP</description>
              <bitRange>[10:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--EXPAND_ADDR: Address Register with expanded fields-->
        <register>
          <name>EXPAND_ADDR</name>
          <description>Address Register with expanded fields</description>
          <alternateRegister>NVRCFG_ADDR</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BANK: Address value for flash operations (Bank number)-->
            <field>
              <name>BANK</name>
              <description>Address value for flash operations (Bank number)</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--SECTOR_ADDR: Sector address value to selected flash IP-->
            <field>
              <name>SECTOR_ADDR</name>
              <description>Sector address value to selected flash IP</description>
              <bitRange>[19:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value within current sector to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value within current sector to selected flash IP</description>
              <bitRange>[10:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DATA: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>DATA[%s]</name>
          <description>DATA</description>
          <addressOffset>0x10</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Data Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0xffffffff</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Data register value for flash operations-->
              <field>
                <name>VAL</name>
                <description>Data register value for flash operations</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--CMD: Command Register-->
        <register>
          <name>CMD</name>
          <description>Command Register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xc0de0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--KEY: Magic Key for flash access "C0DE"-->
            <field>
              <name>KEY</name>
              <description>Magic Key for flash access "C0DE"</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
              <usage>write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Access</name>
                  <description>magic Key for flash access</description>
                  <value>49374</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--NVRON: NVR access bit-->
            <field>
              <name>NVRON</name>
              <description>NVR access bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--DPD: Enter/Exit power down mode-->
            <field>
              <name>DPD</name>
              <description>Enter/Exit power down mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--ALLSEC: Select all sectors for erase-->
            <field>
              <name>ALLSEC</name>
              <description>Select all sectors for erase</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--ERSEC: Erase sector enable command-->
            <field>
              <name>ERSEC</name>
              <description>Erase sector enable command</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--WR: Write enable command-->
            <field>
              <name>WR</name>
              <description>Write enable command</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RD: Read enable command-->
            <field>
              <name>RD</name>
              <description>Read enable command</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STAT: Status Register-->
        <register>
          <name>STAT</name>
          <description>Status Register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--NVRLOCK: If set NVR_CFG sector of flash is locked-->
            <field>
              <name>NVRLOCK</name>
              <description>If set NVR_CFG sector of flash is locked</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--DPD: Flash IP in powerdown mode-->
            <field>
              <name>DPD</name>
              <description>Flash IP in powerdown mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--IRQF: IRQ Flag set when command done. Set by hardware only if IRQEN bit is set.-->
            <field>
              <name>IRQF</name>
              <description>IRQ Flag set when command done. Set by hardware only if IRQEN bit is set.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--BUSY: Busy status bit when command is processing-->
            <field>
              <name>BUSY</name>
              <description>Busy status bit when command is processing</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CTRL: Control Register-->
        <register>
          <name>CTRL</name>
          <description>Control Register</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--LAT: Flash latency-->
            <field>
              <name>LAT</name>
              <description>Flash latency</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--FBFLUSH: Flush internal buffer-->
            <field>
              <name>FBFLUSH</name>
              <description>Flush internal buffer</description>
              <bitRange>[8:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--IRQEN: Interrupt enable bit-->
            <field>
              <name>IRQEN</name>
              <description>Interrupt enable bit</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--FBEN: Fetch buffer Enable-->
            <field>
              <name>FBEN</name>
              <description>Fetch buffer Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCETR: Flash Timing Control register (Erase time)-->
        <register>
          <name>FTCETR</name>
          <description>Flash Timing Control register (Erase time)</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xea60</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TSCE: Erase time value in cycles-->
            <field>
              <name>TSCE</name>
              <description>Erase time value in cycles</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCPRT: Flash Timing Control register (Program time)-->
        <register>
          <name>FTCPRT</name>
          <description>Flash Timing Control register (Program time)</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x48201030</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TPROG: Program time value in cycles-->
            <field>
              <name>TPROG</name>
              <description>Program time value in cycles</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPREPGS: PREPG to PROG2 time value in cycles-->
            <field>
              <name>TPREPGS</name>
              <description>PREPG to PROG2 time value in cycles</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPREPROG: Pre-program time value in cycles-->
            <field>
              <name>TPREPROG</name>
              <description>Pre-program time value in cycles</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPGS: Web to PROG2 high time value in cycles-->
            <field>
              <name>TPGS</name>
              <description>Web to PROG2 high time value in cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCERTR: Flash Timing Control register (Erase Recovery time)-->
        <register>
          <name>FTCERTR</name>
          <description>Flash Timing Control register (Erase Recovery time)</description>
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x32000c8</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRCVCHIP: Chip erase recovery time value in cycles-->
            <field>
              <name>TRCVCHIP</name>
              <description>Chip erase recovery time value in cycles</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TRCVSECT: Sector erase recovery time value in cycles-->
            <field>
              <name>TRCVSECT</name>
              <description>Sector erase recovery time value in cycles</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCPRTR: Flash Timing Control register (Program Recovery time)-->
        <register>
          <name>FTCPRTR</name>
          <description>Flash Timing Control register (Program Recovery time)</description>
          <addressOffset>0x10c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x14</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRCVPROG: Program recovery time value in cycles-->
            <field>
              <name>TRCVPROG</name>
              <description>Program recovery time value in cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ERRMASK: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>ERRMASK[%s]</name>
          <description>ERRMASK</description>
          <addressOffset>0x170</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Flash Data Mask Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Corresponding bit of 32-bit write data bus is inverted-->
              <field>
                <name>VAL</name>
                <description>Corresponding bit of 32-bit write data bus is inverted</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--FECCCR: Flash ECC Control register-->
        <register>
          <name>FECCCR</name>
          <description>Flash ECC Control register</description>
          <addressOffset>0x180</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ERRINJEN: Enable error injection on write data bus-->
            <field>
              <name>ERRINJEN</name>
              <description>Enable error injection on write data bus</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--IDEUEN: Enable interrupt when double errors detected-->
            <field>
              <name>IDEUEN</name>
              <description>Enable interrupt when double errors detected</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--ISEUEN: Enable interrupt when single error detected-->
            <field>
              <name>ISEUEN</name>
              <description>Enable interrupt when single error detected</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--ECCEN: Enable ECC detect and correction-->
            <field>
              <name>ECCEN</name>
              <description>Enable ECC detect and correction</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCISTAT: Flash ECC Interrupt Status register-->
        <register>
          <name>FECCISTAT</name>
          <description>Flash ECC Interrupt Status register</description>
          <addressOffset>0x184</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DEU: Double error occurred-->
            <field>
              <name>DEU</name>
              <description>Double error occurred</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--SEU: Single error occurred-->
            <field>
              <name>SEU</name>
              <description>Single error occurred</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCSEC: Flash ECC Single Error Counter register-->
        <register>
          <name>FECCSEC</name>
          <description>Flash ECC Single Error Counter register</description>
          <addressOffset>0x190</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Single error times occurred-->
            <field>
              <name>VAL</name>
              <description>Single error times occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCDEC: Flash ECC Double Error Counter register-->
        <register>
          <name>FECCDEC</name>
          <description>Flash ECC Double Error Counter register</description>
          <addressOffset>0x194</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Double error times occurred-->
            <field>
              <name>VAL</name>
              <description>Double error times occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCSEA: Flash ECC Single Error Address register-->
        <register>
          <name>FECCSEA</name>
          <description>Flash ECC Single Error Address register</description>
          <addressOffset>0x198</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Last latched address when single error occurred-->
            <field>
              <name>VAL</name>
              <description>Last latched address when single error occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FECCDEA: Flash ECC Double Error Address register-->
        <register>
          <name>FECCDEA</name>
          <description>Flash ECC Double Error Address register</description>
          <addressOffset>0x19c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Last latched address when double error occurred-->
            <field>
              <name>VAL</name>
              <description>Last latched address when double error occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--SIU-->
    <peripheral>
      <name>SIU</name>
      <version>1.0</version>
      <description>System interconnect unit</description>
      <groupName>SIU</groupName>
      <baseAddress>0x50003000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x148</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SIU</name>
        <description>System Interconnect Unit interrupt</description>
        <value>7</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CHIPID: Chip identifier-->
        <register>
          <name>CHIPID</name>
          <description>Chip identifier</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x4e4c101</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ID: Model ID-->
            <field>
              <name>ID</name>
              <description>Model ID</description>
              <bitRange>[31:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--REV: Revision number-->
            <field>
              <name>REV</name>
              <description>Revision number</description>
              <bitRange>[3:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--SERVCTL: Service mode register-->
        <register>
          <name>SERVCTL</name>
          <description>Service mode register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SERVCMD: Service mode erase comand/status-->
            <field>
              <name>SERVCMD</name>
              <description>Service mode erase comand/status</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--SERVSTAT: Service mode status-->
            <field>
              <name>SERVSTAT</name>
              <description>Service mode status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CPESTAT: CPE status register-->
        <register>
          <name>CPESTAT</name>
          <description>CPE status register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CPE: Status of CPE PAD latched-->
            <field>
              <name>CPE</name>
              <description>Status of CPE PAD latched</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--LOCK: Lock configuration register-->
        <register>
          <name>LOCK</name>
          <description>Lock configuration register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CODE: Write key 0xACCE55 to change LOCK bit value-->
            <field>
              <name>CODE</name>
              <description>Write key 0xACCE55 to change LOCK bit value</description>
              <bitRange>[31:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--LOCK: Write with specific code to lock / unlock SIU registers configuration-->
            <field>
              <name>LOCK</name>
              <description>Write with specific code to lock / unlock SIU registers configuration</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CORE1_CLKEN: Core 1 clock enable register-->
        <register>
          <name>CORE1_CLKEN</name>
          <description>Core 1 clock enable register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CODE: Write key 0xACCE55 to change CLKEN bit value when in DUALCORE mode-->
            <field>
              <name>CODE</name>
              <description>Write key 0xACCE55 to change CLKEN bit value when in DUALCORE mode</description>
              <bitRange>[31:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--CLKEN: Clock enable for Core 1-->
            <field>
              <name>CLKEN</name>
              <description>Clock enable for Core 1</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--CORE1_RSTDIS: Core 1 reset disable register-->
        <register>
          <name>CORE1_RSTDIS</name>
          <description>Core 1 reset disable register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CODE: Write key 0xACCE55 to change RSTDIS bit value when in DUALCORE mode-->
            <field>
              <name>CODE</name>
              <description>Write key 0xACCE55 to change RSTDIS bit value when in DUALCORE mode</description>
              <bitRange>[31:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--RSTDIS: Reset disable for Core 1-->
            <field>
              <name>RSTDIS</name>
              <description>Reset disable for Core 1</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--CORE1_RVECT: Core 1 reset vector register-->
        <register>
          <name>CORE1_RVECT</name>
          <description>Core 1 reset vector register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RVECT: Reset vector (affected only in DUALCORE mode)-->
            <field>
              <name>RVECT</name>
              <description>Reset vector (affected only in DUALCORE mode)</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

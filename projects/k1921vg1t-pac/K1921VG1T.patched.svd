            <!--TWMIC: Tx FIFO  Watermark Interrupt Clear-->
            <field>
              <name>TWMIC</name>
              <description>Tx FIFO  Watermark Interrupt Clear</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--RFIC: Rx FIFO  Full  Interrupt Clear-->
            <field>
              <name>RFIC</name>
              <description>Rx FIFO  Full  Interrupt Clear</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--REIC: Rx FIFO  Empty Interrupt Clear-->
            <field>
              <name>REIC</name>

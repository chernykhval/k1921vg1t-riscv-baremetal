              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CBC: Trip-zone Cycle-by-Cycle interrupt enable-->
            <field>
              <name>CBC</name>
              <description>Trip-zone Cycle-by-Cycle interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TZFLG: Trip-Zone Flag Register-->
        <register>
          <name>TZFLG</name>
          <description>Trip-Zone Flag Register</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OST: Latched status flag for a One-Shot trip event-->
            <field>
              <name>OST</name>
              <description>Latched status flag for a One-Shot trip event</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--CBC: Latched status flag for Cycle-By-Cycle trip event-->
            <field>
              <name>CBC</name>
              <description>Latched status flag for Cycle-By-Cycle trip event</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <!--INT: Latched trip interrupt status flag-->
            <field>
              <name>INT</name>
              <description>Latched trip interrupt status flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--TZCLR: Trip-Zone Clear Register-->
        <register>
          <name>TZCLR</name>
          <description>Trip-Zone Clear Register</description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

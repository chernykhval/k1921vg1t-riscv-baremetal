              <description>Remote wakeup</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--TS: Testmode selector-->
            <field>
              <name>TS</name>
              <description>Testmode selector</description>
              <bitRange>[11:9]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Reserved0</name>
                  <description>Reserved</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Test_J</name>
                  <description>Test Mode J</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Test_K</name>
                  <description>Test Mode K</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Test_SE0_NAK</name>
                  <description>Test Mode SE0 Not ACK</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Test_Packet</name>
                  <description>Test Mode packet</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reserved5</name>
                  <description>Reserved</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reserved6</name>
                  <description>Reserved</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reserved7</name>
                  <description>Reserved</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TM: Enable test mode-->
            <field>
              <name>TM</name>
              <description>Enable test mode</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--UA: USB address-->
            <field>
              <name>UA</name>
              <description>USB address</description>
              <bitRange>[7:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--SU: Set USB address-->
            <field>
              <name>SU</name>
              <description>Set USB address</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--GSTAT: USBDC Status register-->
        <register>
          <name>GSTAT</name>
          <description>USBDC Status register</description>
          <addressOffset>0x204</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--NEPI: Number of implemented IN endpoints-->
            <field>
              <name>NEPI</name>
              <description>Number of implemented IN endpoints</description>
              <bitRange>[31:28]</bitRange>
              <access>read-only</access>
            </field>
            <!--NEPO: Number of implemented OUT endpoints-->
            <field>
              <name>NEPO</name>
              <description>Number of implemented OUT endpoints</description>
              <bitRange>[27:24]</bitRange>
              <access>read-only</access>
            </field>
            <!--DM: Data mode-->
            <field>
              <name>DM</name>
              <description>Data mode</description>
              <bitRange>[23:23]</bitRange>
              <access>read-only</access>
              <usage>read</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Slave_Data_Mode</name>
                  <description>core uses slave mode for data transfers</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Master_Data_Mode</name>
                  <description>core uses master mode (DMA) for data transfers</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SU: Suspend-->
            <field>
              <name>SU</name>
              <description>Suspend</description>
              <bitRange>[17:17]</bitRange>
              <access>read-only</access>
            </field>
            <!--UR: USB reset-->
            <field>
              <name>UR</name>
              <description>USB reset</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--VB: VBUS valid-->
            <field>
              <name>VB</name>
              <description>VBUS valid</description>
              <bitRange>[15:15]</bitRange>
              <access>read-only</access>
            </field>
            <!--SP: Speed-->
            <field>
              <name>SP</name>
              <description>Speed</description>
              <bitRange>[14:14]</bitRange>
              <access>read-only</access>
            </field>
            <!--AF: Additional frames-->
            <field>
              <name>AF</name>
              <description>Additional frames</description>
              <bitRange>[13:11]</bitRange>
              <access>read-only</access>
            </field>
            <!--FN: Frame number-->
            <field>
              <name>FN</name>
              <description>Frame number</description>
              <bitRange>[10:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--USBDC1-->
    <peripheral derivedFrom="USBDC0">

        <!--UARTCFG: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-7</dimIndex>
          <!--end of dimElementGroup-->
          <name>UARTCFG[%s]</name>
          <description>UARTCFG</description>
          <addressOffset>0x50</addressOffset>
          <register>
            <name>VALUE</name>
            <description>UART Clock and Reset Configuration Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--DIVN: Divider coefficient-->
              <field>
                <name>DIVN</name>
                <description>Divider coefficient</description>
                <bitRange>[21:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--DIVEN: Enable divider-->
              <field>
                <name>DIVEN</name>
                <description>Enable divider</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <!--CLKSEL: Clock source select-->
              <field>
                <name>CLKSEL</name>
                <description>Clock source select</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>REFCLK</name>
                    <description>HSI 4MHz if CPE=0 or HSE(XTALL) if CPE=1</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SRCCLK</name>
                    <description>HSE(XTALL) if CPE=0 or HSI 4MHz if CPE=1</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SYSPLL0CLK</name>
                    <description>Clock from PLL OUT[0]</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EXTCLK</name>
                    <description>external CLK from gpio pin</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <!--RSTDIS: Reset disable-->
              <field>
                <name>RSTDIS</name>
                <description>Reset disable</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <!--CLKEN: Clock enable-->
              <field>
                <name>CLKEN</name>
                <description>Clock enable</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--SPICFG: -->

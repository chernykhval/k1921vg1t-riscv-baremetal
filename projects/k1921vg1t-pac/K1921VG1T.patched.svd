            <field>
              <name>OST4</name>
              <description>One-Shot trip-zone 4 enable</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--OST3: One-Shot trip-zone 3 enable-->
            <field>
              <name>OST3</name>
              <description>One-Shot trip-zone 3 enable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--OST2: One-Shot trip-zone 2 enable-->
            <field>
              <name>OST2</name>
              <description>One-Shot trip-zone 2 enable</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--OST1: One-Shot trip-zone 1 enable-->
            <field>
              <name>OST1</name>
              <description>One-Shot trip-zone 1 enable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

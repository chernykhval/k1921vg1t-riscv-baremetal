        <!--LOCK: Lock configuration register-->
        <register>
          <name>LOCK</name>
          <description>Lock configuration register</description>
          <addressOffset>0x3c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CODE: Write key 0xACCE55 to change LOCK bit value-->
            <field>
              <name>CODE</name>
              <description>Write key 0xACCE55 to change LOCK bit value</description>
              <bitRange>[31:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--LOCK: Write with specific code to lock / unlock RCU registers configuration-->
            <field>
              <name>LOCK</name>
              <description>Write with specific code to lock / unlock RCU registers configuration</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>

              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--SYNTTC: TTC Capture Mode-->
            <field>
              <name>SYNTTC</name>
              <description>TTC Capture Mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CAP_SOF</name>
                  <description>Capture TTC Timer by SOF bit</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CAP_EOF</name>
                  <description>Capture TTC Timer by EOF bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>

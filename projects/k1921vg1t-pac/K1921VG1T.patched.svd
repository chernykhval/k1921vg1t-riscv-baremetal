          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CODE: Write key 0xACCE55 to change LOCK bit value-->
            <field>
              <name>CODE</name>
              <description>Write key 0xACCE55 to change LOCK bit value</description>
              <bitRange>[31:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--DUALCORE: If set, second core work independent from first core-->
            <field>
              <name>DUALCORE</name>
              <description>If set, second core work independent from first core</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOCKSTEP</name>
                  <description>Second core work in lockstep mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUALCORE</name>
                  <description>Second core work independently</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

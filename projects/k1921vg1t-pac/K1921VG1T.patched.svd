    <!--QSPI1-->
    <peripheral derivedFrom="QSPI0">
      <name>QSPI1</name>
      <baseAddress>0x41040000</baseAddress>
      <interrupt>
        <name>QSPI1</name>
        <description>QSPI1 interrupt</description>
        <value>167</value>
      </interrupt>
    </peripheral>
    <!--CRC-->
    <peripheral>
      <name>CRC</name>
      <version>1.0</version>
      <description>Cyclic redundancy check module</description>
      <groupName>CRC</groupName>
      <baseAddress>0x41050000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x14</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--DR: CRC Data register-->
        <register>
          <name>DR</name>
          <description>CRC Data register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Data register-->
            <field>
              <name>VAL</name>
              <description>Data register</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--POST: CRC post register-->
        <register>
          <name>POST</name>
          <description>CRC post register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Post-processing CRC value-->
            <field>
              <name>VAL</name>
              <description>Post-processing CRC value</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CR: CRC control register-->
        <register>
          <name>CR</name>
          <description>CRC control register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--REV_OUT: Reverse output data-->
            <field>
              <name>REV_OUT</name>
              <description>Reverse output data</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Bit order not affected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Bit-reversed output format</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--REV_IN: Reverse input data. These bits control the reversal of the bit order of the input data-->
            <field>
              <name>REV_IN</name>
              <description>Reverse input data. These bits control the reversal of the bit order of the input data</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Bit order not affected(default)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REV_BYTE</name>
                  <description>Bit reversal done by byte</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REV_HALFWORD</name>
                  <description>Bit reversal done by half-word</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REV_WORD</name>
                  <description>Bit reversal done by word</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--POLYSIZE: Polynomial size. These bits control the size of the polynomial-->
            <field>
              <name>POLYSIZE</name>
              <description>Polynomial size. These bits control the size of the polynomial</description>
              <bitRange>[4:3]</bitRange>
              <access>read-only</access>
              <usage>read</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>POL32</name>
                  <description>32 bit polynomial</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POL16</name>
                  <description>16 bit polynomial</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POL8</name>
                  <description>8 bit polynomial</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POL7</name>
                  <description>7 bit polynomial</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--XOROUT: XOR for data out-->
            <field>
              <name>XOROUT</name>
              <description>XOR for data out</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Output XOR operation is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Output XOR operation is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--MODE: Mode calc CRC-->
            <field>
              <name>MODE</name>
              <description>Mode calc CRC</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>StandartCRC</name>
                  <description>Standart mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STM32_CRC</name>
                  <description>STM32 compatible mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--RESET: RESET bit-->
            <field>
              <name>RESET</name>
              <description>RESET bit</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--INIT: CRC initial value register-->
        <register>
          <name>INIT</name>
          <description>CRC initial value register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Initial CRC value-->
            <field>
              <name>VAL</name>
              <description>Initial CRC value</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--POL: CRC polynomial register-->
        <register>
          <name>POL</name>
          <description>CRC polynomial register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x4c11db7</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Programmable polynomial value-->
            <field>
              <name>VAL</name>
              <description>Programmable polynomial value</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--HASH-->
    <peripheral>
      <name>HASH</name>
      <version>1.0</version>
      <description>HASH registers</description>
      <groupName>HASH</groupName>
      <baseAddress>0x41060000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x60</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>HASH</name>
        <description>HASH interrupt</description>
        <value>212</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CR: Control register-->
        <register>
          <name>CR</name>
          <description>Control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ALGO: Algorithm selection-->
            <field>
              <name>ALGO</name>
              <description>Algorithm selection</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SHA1</name>
                  <description>SHA-1 algorithm selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MD5</name>
                  <description>MD5 algorithm selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHA224</name>
                  <description>SHA224 algorithm selected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHA256</name>
                  <description>SHA256 algorithm selected</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DINNE: DIN not empty-->
            <field>
              <name>DINNE</name>
              <description>DIN not empty</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <!--NBW: Number of words already pushed-->
            <field>
              <name>NBW</name>
              <description>Number of words already pushed</description>
              <bitRange>[11:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--MDMAT: Multiple DMA transfers-->
            <field>
              <name>MDMAT</name>
              <description>Multiple DMA transfers</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--DMAE: DMA enable-->
            <field>
              <name>DMAE</name>
              <description>DMA enable</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--DATATYPE: Datatype selection-->
            <field>
              <name>DATATYPE</name>
              <description>Datatype selection</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WORD</name>
                  <description>32-bit data. The data written into HASH_DIN are directly used by the HASH processing, without reordering</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HWORD</name>
                  <description>16-bit data, or half-word. The data written into HASH_DIN are considered as 2 half-words, and are swapped before being used by the HASH processing</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BYTE</name>
                  <description>8-bit data, or bytes. The data written into HASH_DIN are considered as 4 bytes, and are swapped before being used by the HASH processing</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BIT</name>
                  <description>bit data, or bit-string. The data written into HASH_DIN are considered as 32bits (1st bit of the sting at position 0), and are swapped before being used by the HASH processing (1st bit of the string at position 31)</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SAMK: Same key option-->
            <field>
              <name>SAMK</name>
              <description>Same key option</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--LKEY: Long key selection-->
            <field>
              <name>LKEY</name>
              <description>Long key selection</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HMAC_SHORT_KEY</name>
                  <description>Short key (≤ 64 bytes)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HMAC_LONG_KEY</name>
                  <description>Long key (&gt; 64 bytes)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--MODE: Mode selection-->
            <field>
              <name>MODE</name>
              <description>Mode selection</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HASH</name>
                  <description>Hash mode selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HMAC</name>
                  <description>HMAC mode selected. LKEY must be set if the key being used is longer than 64 bytes. SAMK option for long key must be set if the keys used for inner/outer hash functions are identical</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--INIT: Initialize message digest calculation-->
            <field>
              <name>INIT</name>
              <description>Initialize message digest calculation</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--DATAIN: Data input register-->
        <register>
          <name>DATAIN</name>
          <description>Data input register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Data input-->
            <field>
              <name>VAL</name>
              <description>Data input</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STR: Start register-->
        <register>
          <name>STR</name>
          <description>Start register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>

            <field>
              <name>DDR</name>
              <description>Double Data Rate ( 0 - SDR ; 1 - DDR )</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SDR</name>
                  <description>Single Data Rate</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DDR</name>
                  <description>Double Data Rate</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--LSBF: LSB First ( 0 - MSB First; 1 - LSB First )-->

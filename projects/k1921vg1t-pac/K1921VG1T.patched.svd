        <!--TDS: Transfer Data size register-->
        <register>
          <name>TDS</name>
          <description>Transfer Data size register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--QCC: QSPI Communication Config register-->
        <register>
          <name>QCC</name>
          <description>QSPI Communication Config register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DDRM: QSPI Double Data Rate Mode:  ( 0 - SDR; 1 - DDR )  This bit sets the DDR mode for address, alt bytes, and data phases-->
            <field>
              <name>DDRM</name>
              <description>QSPI Double Data Rate Mode:  ( 0 - SDR; 1 - DDR )  This bit sets the DDR mode for address, alt bytes, and data phases</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <!--DIOD: QSPI Data IO Direction-->
            <field>
              <name>DIOD</name>
              <description>QSPI Data IO Direction</description>
              <bitRange>[27:26]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WR</name>
                  <description>Indirect write mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RD</name>
                  <description>Indirect read  mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DMOD: Data mode-->
            <field>
              <name>DMOD</name>
              <description>Data mode</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NoData</name>
                  <description>No data</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Single</name>
                  <description>Single lines for serial IO</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Double</name>
                  <description>Double lines for serial IO</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Quad</name>
                  <description>Quad lines for serial IO</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DCYCS: Number of dummy cycles ( This field defines of the dummy phase. ) It specifies a number of CLK cycles ( 0-31 )-->
            <field>
              <name>DCYCS</name>
              <description>Number of dummy cycles ( This field defines of the dummy phase. ) It specifies a number of CLK cycles ( 0-31 )</description>
              <bitRange>[22:18]</bitRange>
              <access>read-write</access>
            </field>
            <!--ABSIZ: Alternate bytes size-->
            <field>
              <name>ABSIZ</name>
              <description>Alternate bytes size</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AltBytesSize_8</name>
                  <description>8-bit alternate byte</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AltBytesSize_16</name>
                  <description>16-bit alternate byte</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AltBytesSize_24</name>
                  <description>24-bit alternate byte</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AltBytesSize_32</name>
                  <description>32-bit alternate byte</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--ABMOD: Alternate bytes mode-->
            <field>
              <name>ABMOD</name>
              <description>Alternate bytes mode</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AltBytesNo</name>
                  <description>No alternate bytes</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AltBytesSIO</name>
                  <description>Alternate bytes on a single line</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AltBytesDIO</name>
                  <description>Alternate bytes on two lines</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AltBytesQIO</name>
                  <description>Alternate bytes on four lines</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--ADSIZ: Address size-->
            <field>
              <name>ADSIZ</name>
              <description>Address size</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AddrSize_8</name>
                  <description>8-bit address</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AddrSize_16</name>
                  <description>16-bit address</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AddrSize_24</name>
                  <description>24-bit address</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AddrSize_32</name>
                  <description>32-bit address</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--ADMOD: Address mode-->
            <field>
              <name>ADMOD</name>
              <description>Address mode</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No address</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AddrSIO</name>
                  <description>Address on a single line</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AddrDIO</name>
                  <description>Address on two lines</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AddrQIO</name>
                  <description>Address on four lines</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--IMOD: Instruction mode-->
            <field>
              <name>IMOD</name>
              <description>Instruction mode</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No instruction</description>
                  <value>0</value>

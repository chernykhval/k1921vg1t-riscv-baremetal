    <!--DAC0-->
    <peripheral>
      <name>DAC0</name>
      <version>1.0</version>
      <description>DAC control registers</description>
      <groupName>DAC</groupName>
      <baseAddress>0x51004000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x40</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--DATA12: Output data register (12-bit)-->
        <register>
          <name>DATA12</name>
          <description>Output data register (12-bit)</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DATA8: Output data register (8-bit)-->
        <register>
          <name>DATA8</name>
          <description>Output data register (8-bit)</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Write 8 most significant bits (4 less significant bits will be set to 0)-->
            <field>
              <name>VAL</name>
              <description>Write 8 most significant bits (4 less significant bits will be set to 0)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DATA_DUAL: Output data register (Dual mode and DAC0 only)-->
        <register>
          <name>DATA_DUAL</name>
          <description>Output data register (Dual mode and DAC0 only)</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DAC1: Value for DAC1 in Dual mode-->
            <field>
              <name>DAC1</name>
              <description>Value for DAC1 in Dual mode</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--DAC0: Value for DAC0 in Dual mode-->
            <field>
              <name>DAC0</name>
              <description>Value for DAC0 in Dual mode</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CONTROL: Control register-->
        <register>
          <name>CONTROL</name>
          <description>Control register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OFFSET: Offset for pattern generator-->
            <field>
              <name>OFFSET</name>
              <description>Offset for pattern generator</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--NEGATE: Convert data to it's two's complement value-->
            <field>
              <name>NEGATE</name>
              <description>Convert data to it's two's complement value</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--MULDIV: Switch between up and downscale-->
            <field>
              <name>MULDIV</name>
              <description>Switch between up and downscale</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DOWNSCALE</name>
                  <description>division (shift SCALE positions to the right)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UPSCALE</name>
                  <description>multiplication (shift SCALE positions to the left)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SCALE: Scale value for up/downscale input data in steps by power of 2-->
            <field>
              <name>SCALE</name>
              <description>Scale value for up/downscale input data in steps by power of 2</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOSHIFT</name>
                  <description>multiplication/division by 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT1</name>
                  <description>multiplication/division by 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT2</name>
                  <description>multiplication/division by 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT3</name>
                  <description>multiplication/division by 8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT4</name>
                  <description>multiplication/division by 16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT5</name>
                  <description>multiplication/division by 32</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT6</name>
                  <description>multiplication/division by 64</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT7</name>
                  <description>multiplication/division by 128</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--MASK: DAC channel mask/amplitude selector-->
            <field>
              <name>MASK</name>
              <description>DAC channel mask/amplitude selector</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--SIGN: Signed DAC mode enable-->
            <field>
              <name>SIGN</name>

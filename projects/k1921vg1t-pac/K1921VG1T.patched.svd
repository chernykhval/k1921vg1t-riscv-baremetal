    <!--LIN0-->
    <peripheral>
      <name>LIN0</name>
      <version>1.0</version>
      <description>LIN control registers</description>
      <groupName>LIN</groupName>
      <baseAddress>0x52000000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x64</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>LIN0</name>
        <description>LIN0 combine interrupt</description>
        <value>144</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--DTX: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-7</dimIndex>
          <!--end of dimElementGroup-->
          <name>DTX[%s]</name>
          <description>DTX</description>
          <addressOffset>0x0</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Transmitted data register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--TXD: Transmitted data-->
              <field>
                <name>TXD</name>
                <description>Transmitted data</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--DRX: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-7</dimIndex>
          <!--end of dimElementGroup-->
          <name>DRX[%s]</name>
          <description>DRX</description>
          <addressOffset>0x20</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Received data register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--RXD: Received data-->
              <field>
                <name>RXD</name>
                <description>Received data</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--CR: Control register-->
        <register>
          <name>CR</name>
          <description>Control register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x801</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SLP: Sleep state bit-->
            <field>
              <name>SLP</name>
              <description>Sleep state bit</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <!--CSUMTP: Checksum type bit-->
            <field>
              <name>CSUMTP</name>
              <description>Checksum type bit</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <!--PROTVR: Protocol type bit-->
            <field>
              <name>PROTVR</name>
              <description>Protocol type bit</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <!--MS: Device type bit master/slave-->
            <field>
              <name>MS</name>
              <description>Device type bit master/slave</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--UDL: Number of data fields in one message frame-->
            <field>
              <name>UDL</name>
              <description>Number of data fields in one message frame</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--MESTP: Message frame type-->
            <field>
              <name>MESTP</name>
              <description>Message frame type</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>IDLE state (only in transmit mode)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HEADER</name>
                  <description>HEADER state</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HEADER_RESPONSE</name>
                  <description>HEADER+RESPONSE state</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESPONSE_RESEIVE</name>
                  <description>RESPONSE RESEIVE state</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESPONSE_TRANSMIT</name>
                  <description>RESPONSE TRANSMIT state</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SEND_WAKE</name>
                  <description>send a signal WAKE</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--SR: Status register-->
        <register>
          <name>SR</name>
          <description>Status register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--STBITM: No stop symbol bit-->
            <field>
              <name>STBITM</name>
              <description>No stop symbol bit</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <!--INVPID: PID error bit-->
            <field>
              <name>INVPID</name>
              <description>PID error bit</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <!--INVCSUM: Checksum error bit-->
            <field>
              <name>INVCSUM</name>
              <description>Checksum error bit</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <!--ERLCONF: Line conflict bit-->
            <field>
              <name>ERLCONF</name>
              <description>Line conflict bit</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--CSUMRV: Checksum received bit-->
            <field>
              <name>CSUMRV</name>
              <description>Checksum received bit</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--DATARV: Data received bit-->
            <field>
              <name>DATARV</name>
              <description>Data received bit</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--PIDRV: PID received bit-->
            <field>
              <name>PIDRV</name>
              <description>PID received bit</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--ENDTXFR: End of transmission bit-->
            <field>
              <name>ENDTXFR</name>
              <description>End of transmission bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--GTSLP: Received message frame is a sleep signal-->
            <field>
              <name>GTSLP</name>
              <description>Received message frame is a sleep signal</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--WFSLP: During sleep, a wake-up signal is received-->
            <field>
              <name>WFSLP</name>
              <description>During sleep, a wake-up signal is received</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--TR: The activity bit of the transmitting part of the interface-->
            <field>
              <name>TR</name>
              <description>The activity bit of the transmitting part of the interface</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--RV: The activity bit of the receiving part of the interface-->
            <field>
              <name>RV</name>
              <description>The activity bit of the receiving part of the interface</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <!--FRS: Current state of the device-->
            <field>
              <name>FRS</name>
              <description>Current state of the device</description>
              <bitRange>[2:0]</bitRange>
              <access>read-only</access>
              <usage>read</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>IDLE state (only in transmit mode)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BREAK</name>
                  <description>BREAK state</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYNC</name>
                  <description>SYNC state</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PID</name>
                  <description>PID state</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATA</name>
                  <description>DATA state</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CSUM</name>
                  <description>CSUM state</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SEND_WAKE</name>
                  <description>send a signal WAKE state</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--BL: Register for setting the length of the BREAK field-->
        <register>
          <name>BL</name>
          <description>Register for setting the length of the BREAK field</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1e7</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BRKLEN: Minimum length of the synchronization break field-->
            <field>
              <name>BRKLEN</name>
              <description>Minimum length of the synchronization break field</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--SRR: Transfer rate setting register-->
        <register>
          <name>SRR</name>
          <description>Transfer rate setting register</description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x12c</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SPDR: Transmission rate of the main device-->
            <field>
              <name>SPDR</name>
              <description>Transmission rate of the main device</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PTX: Register of the PID being sent-->
        <register>
          <name>PTX</name>
          <description>Register of the PID being sent</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--PIDTX: PID is sent in the next data frame-->
            <field>
              <name>PIDTX</name>
              <description>PID is sent in the next data frame</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PRX: Register of the received PID-->
        <register>
          <name>PRX</name>
          <description>Register of the received PID</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--PIDRX: Value of the received PID-->
            <field>
              <name>PIDRX</name>
              <description>Value of the received PID</description>
              <bitRange>[5:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CSRX: Register of the received checksum-->
        <register>
          <name>CSRX</name>
          <description>Register of the received checksum</description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CSUMRX: Value of the accepted checksum-->
            <field>
              <name>CSUMRX</name>
              <description>Value of the accepted checksum</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--IM: Mask interrupt register-->
        <register>
          <name>IM</name>
          <description>Mask interrupt register</description>
          <addressOffset>0x5c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--STBITMEN: Enable interrupt by the failure of a stop bit-->
            <field>
              <name>STBITMEN</name>
              <description>Enable interrupt by the failure of a stop bit</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <!--INVPIDEN: Enable interrupt to receive a PID with broken parity-->
            <field>
              <name>INVPIDEN</name>
              <description>Enable interrupt to receive a PID with broken parity</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <!--INVCSUMEN: Enable interrupt to receive an incorrect checksum-->
            <field>
              <name>INVCSUMEN</name>
              <description>Enable interrupt to receive an incorrect checksum</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <!--ERLCONFEN: Enable interrupt when a line conflict occurs-->
            <field>
              <name>ERLCONFEN</name>
              <description>Enable interrupt when a line conflict occurs</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--CSUMRVEN: Enable interrupt by receiving of the checksum field-->
            <field>
              <name>CSUMRVEN</name>
              <description>Enable interrupt by receiving of the checksum field</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--DATARVEN: Enable interrupt by receiving a data field-->
            <field>
              <name>DATARVEN</name>
              <description>Enable interrupt by receiving a data field</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--PIDRVEN: Enable interrupt by receiving the PID field-->
            <field>
              <name>PIDRVEN</name>
              <description>Enable interrupt by receiving the PID field</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--ENDTXFREN: Enable interrupt when the transmission of the next message frame is completed-->
            <field>
              <name>ENDTXFREN</name>
              <description>Enable interrupt when the transmission of the next message frame is completed</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--GTSLPEN: Enable interrupt when receiving a sleep signal-->
            <field>
              <name>GTSLPEN</name>
              <description>Enable interrupt when receiving a sleep signal</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--WFSLPEN: Enable interrupt when receiving a wake-up signal-->
            <field>
              <name>WFSLPEN</name>
              <description>Enable interrupt when receiving a wake-up signal</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--TREN: Enable interrupt by activating the transmitting part of the device-->
            <field>
              <name>TREN</name>
              <description>Enable interrupt by activating the transmitting part of the device</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--RVEN: Enable interrupt by activating the receiving part of the device-->
            <field>
              <name>RVEN</name>
              <description>Enable interrupt by activating the receiving part of the device</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--FSEN: Enable interrupt when message frame field set-->
            <field>
              <name>FSEN</name>
              <description>Enable interrupt when message frame field set</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--MIS: Masked interrupt status register-->
        <register>
          <name>MIS</name>

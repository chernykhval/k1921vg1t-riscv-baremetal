        <!--CH: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>32</dim>
          <dimIncrement>128</dimIncrement>
          <dimIndex>0-31</dimIndex>
          <!--end of dimElementGroup-->
          <name>CH[%s]</name>
          <description>CH</description>
          <addressOffset>0x0</addressOffset>
          <register>
            <name>SRC_PTR</name>
            <description>Command register 0 (source pointer)</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--RD_ADDR: Start address of read buffer-->
              <field>
                <name>RD_ADDR</name>
                <description>Start address of read buffer</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DST_PTR</name>
            <description>Command register 1 (destination pointer)</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--WR_ADDR: Start address of write buffer-->
              <field>
                <name>WR_ADDR</name>
                <description>Start address of write buffer</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>NDTL</name>
            <description>Command register 2 (number of data to transfer, linear mode)</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--BUFFER_SIZE: Size of buffer to transfer-->
              <field>
                <name>BUFFER_SIZE</name>
                <description>Size of buffer to transfer</description>
                <bitRange>[9:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>NDTB</name>
            <description>Command register 2 (number of data to transfer, block mode) - Not Implemented</description>
            <alternateRegister>NDTL</alternateRegister>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--Y_SIZE: Number of block lines  - Not Implemented-->
              <field>
                <name>Y_SIZE</name>
                <description>Number of block lines  - Not Implemented</description>
                <bitRange>[9:8]</bitRange>
                <access>read-only</access>
              </field>
              <!--X_SIZE: Number of block lines  - Not Implemented-->
              <field>
                <name>X_SIZE</name>
                <description>Number of block lines  - Not Implemented</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG</name>
            <description>Command register 3 (config)</description>
            <addressOffset>0xc</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--NEXT_ADDR: Address of next command-->
              <field>
                <name>NEXT_ADDR</name>
                <description>Address of next command</description>
                <bitRange>[31:2]</bitRange>
                <access>read-write</access>
              </field>
              <!--CMD_LAST: This is a last DMA command-->

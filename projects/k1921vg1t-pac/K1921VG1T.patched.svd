            <!--SRC: REFCLK:0:HSI 4MHz if CPE=0 or HSE(XTALL) if CPE=1;SRCCLK:1:HSE(XTALL) if CPE=0 or HSI 4MHz if CPE=1;SYSPLL0CLK:2: Clock from PLL OUT[0];EXTCLK:3: external CLK from gpio pin;-->
            <field>

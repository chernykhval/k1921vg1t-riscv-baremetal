          <!--end of dimElementGroup-->
          <name>U_ITEM[%s]</name>
          <description>U_ITEM</description>
          <addressOffset>0x40</addressOffset>
          <register>
            <name>VALUE</name>
            <description>Upstream item index 0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--ERR_LS: Error Low Stop bit(s)-->
              <field>
                <name>ERR_LS</name>
                <description>Error Low Stop bit(s)</description>
                <bitRange>[21:21]</bitRange>
                <access>read-only</access>
              </field>
              <!--ERR_P: Error Parity bit-->
              <field>
                <name>ERR_P</name>
                <description>Error Parity bit</description>
                <bitRange>[20:20]</bitRange>
                <access>read-only</access>
              </field>
              <!--ERR_HS: Erorr High Start bit-->
              <field>
                <name>ERR_HS</name>
                <description>Erorr High Start bit</description>
                <bitRange>[19:19]</bitRange>
                <access>read-only</access>
              </field>
              <!--CLEAR: Clear item valit bit-->
              <field>
                <name>CLEAR</name>
                <description>Clear item valit bit</description>
                <bitRange>[18:18]</bitRange>
                <access>write-only</access>
              </field>
              <!--RP: Received Parity bit-->
              <field>
                <name>RP</name>
                <description>Received Parity bit</description>
                <bitRange>[17:17]</bitRange>
                <access>read-only</access>
              </field>
              <!--VALID: item Valid bit-->
              <field>
                <name>VALID</name>
                <description>item Valid bit</description>
                <bitRange>[16:16]</bitRange>
                <access>read-only</access>
              </field>
              <!--ADDR: Address field-->
              <field>
                <name>ADDR</name>
                <description>Address field</description>
                <bitRange>[11:8]</bitRange>
                <access>read-only</access>
              </field>
              <!--DATA: Data field-->
              <field>
                <name>DATA</name>
                <description>Data field</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
  </peripherals>
</device>

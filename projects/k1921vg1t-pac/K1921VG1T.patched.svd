              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--SRC: System clock source-->
            <field>
              <name>SRC</name>
              <description>System clock source</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>REFCLK</name>
                  <description>HSI 4MHz if CPE=0 or HSE(XTALL) if CPE=1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SRCCLK</name>
                  <description>HSE(XTALL) if CPE=0 or HSI 4MHz if CPE=1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSPLL0CLK</name>
                  <description>Clock from PLL OUT[0]</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTCLK</name>
                  <description>external CLK from gpio pin</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

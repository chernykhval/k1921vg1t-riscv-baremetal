    <!--USBHC0-->
    <peripheral>
      <name>USBHC0</name>
      <version>1.0</version>
      <description>USBHC control registers</description>
      <groupName>USBHC</groupName>
      <baseAddress>0x41081000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x814</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--CAPLENGTH: USBHC Capabilities register-->
        <register>
          <name>CAPLENGTH</name>
          <description>USBHC Capabilities register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x1000014</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--HCIVERSION: Host Controller Interface Version Number-->
            <field>
              <name>HCIVERSION</name>
              <description>Host Controller Interface Version Number</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <!--CAPLENGTH: Capabilities register length-->
            <field>
              <name>CAPLENGTH</name>
              <description>Capabilities register length</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--HCSPARAMS: USBHC Structural Parameters register-->
        <register>
          <name>HCSPARAMS</name>
          <description>USBHC Structural Parameters register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x1111</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>

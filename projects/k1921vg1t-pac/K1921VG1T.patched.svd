    <!--ACMP0-->
    <peripheral>
      <name>ACMP0</name>
      <version>1.0</version>
      <description>Analog comparator control registers</description>
      <groupName>ACMP</groupName>
      <baseAddress>0x51000000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>ACMP0</name>
        <description>ACMP0  interrupt</description>
        <value>207</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--DACCTL: DAC control register-->
        <register>
          <name>DACCTL</name>
          <description>DAC control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--EN: Enable DAC for comparator-->
            <field>
              <name>EN</name>
              <description>Enable DAC for comparator</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--REF1: Select Voltage for DAC output channel 1-->
            <field>
              <name>REF1</name>
              <description>Select Voltage for DAC output channel 1</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--REF0: Select voltage for DAC output channel 0-->
            <field>
              <name>REF0</name>
              <description>Select voltage for DAC output channel 0</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ACMPCTL: ACMP control register-->
        <register>
          <name>ACMPCTL</name>
          <description>ACMP control register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRIGSRC: Select trigger event-->
            <field>
              <name>TRIGSRC</name>
              <description>Select trigger event</description>
              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--INTSRC: Select interrupt source-->
            <field>
              <name>INTSRC</name>
              <description>Select interrupt source</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--SELIN: Select input for IN0-->
            <field>
              <name>SELIN</name>
              <description>Select input for IN0</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INPUT</name>
                  <description>Selects IN_P</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TEST</name>
                  <description>Select test out from DAC</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SELREF: Select reference voltage-->
            <field>
              <name>SELREF</name>
              <description>Select reference voltage</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXT</name>
                  <description>Select IN_N as reference voltage</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC_CH0</name>
                  <description>Select DAC channel 0 as reference voltage</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC_CH1</name>
                  <description>Select DAC channel 1 as reference voltage</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RSRV</name>
                  <description>Reserved (unpredicted result)</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--INV: Inverse output-->
            <field>
              <name>INV</name>
              <description>Inverse output</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--RSTN: Reset comparator (active low)-->
            <field>
              <name>RSTN</name>
              <description>Reset comparator (active low)</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--DIS: Disable comparator-->
            <field>
              <name>DIS</name>
              <description>Disable comparator</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ACSTATUS: ACMP status-->
        <register>
          <name>ACSTATUS</name>
          <description>ACMP status</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--STATE: Comparator output pin status-->
            <field>
              <name>STATE</name>
              <description>Comparator output pin status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--INTEN: Interrupt enable-->
        <register>
          <name>INTEN</name>
          <description>Interrupt enable</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CMP: Interrupt enable-->
            <field>
              <name>CMP</name>
              <description>Interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--RIS: Raw interrupt status-->
        <register>
          <name>RIS</name>
          <description>Raw interrupt status</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CMP: Raw interrupt status-->
            <field>
              <name>CMP</name>
              <description>Raw interrupt status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--MIS: Masked interrupt status-->
        <register>
          <name>MIS</name>
          <description>Masked interrupt status</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CMP: Masked interrupt status-->
            <field>
              <name>CMP</name>
              <description>Masked interrupt status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--ICLR: Clear interrupt status-->
        <register>
          <name>ICLR</name>
          <description>Clear interrupt status</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CMP: Clear interrupt status-->
            <field>
              <name>CMP</name>
              <description>Clear interrupt status</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <!--QSPI0-->
    <peripheral>
      <name>QSPI0</name>
      <version>1.0</version>
      <description>QSPI control registers</description>
      <groupName>QSPI</groupName>
      <baseAddress>0x41030000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x38</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>QSPI0</name>
        <description>QSPI0 interrupt</description>
        <value>166</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--HCR: Host Control Register-->
        <register>
          <name>HCR</name>
          <description>Host Control Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RXFCLR: Rx FIFO clear-->
            <field>
              <name>RXFCLR</name>
              <description>Rx FIFO clear</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--TXFCLR: Tx FIFO clear-->
            <field>
              <name>TXFCLR</name>
              <description>Tx FIFO clear</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--DRS: Device reset   ( SW reset )-->
            <field>
              <name>DRS</name>
              <description>Device reset   ( SW reset )</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--DEN: Device enable-->
            <field>
              <name>DEN</name>
              <description>Device enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DCR: Device Config Register-->
        <register>
          <name>DCR</name>
          <description>Device Config Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x100</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--FMOD: Functional mode ( [00] - Std.SPI ; [01] - Reserved ; [10] - QSPI Memory Interface ; [11] - Test LoopBack )-->
            <field>
              <name>FMOD</name>
              <description>Functional mode ( [00] - Std.SPI ; [01] - Reserved ; [10] - QSPI Memory Interface ; [11] - Test LoopBack )</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SPI</name>
                  <description>Standart SPI</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QSPI</name>
                  <description>QSPI Memory Interface</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOOPBACK</name>
                  <description>Test LoopBack</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CDIV: Serial clock DIV value-->
            <field>
              <name>CDIV</name>
              <description>Serial clock DIV value</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--CPOL: Serial clock polarity-->
            <field>
              <name>CPOL</name>
              <description>Serial clock polarity</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--CPHA: Serial clock phase-->
            <field>
              <name>CPHA</name>
              <description>Serial clock phase</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DSR: Device status register-->
        <register>
          <name>DSR</name>
          <description>Device status register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x50</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RXFCNT: Curent Rx FIFO Element Count-->
            <field>
              <name>RXFCNT</name>
              <description>Curent Rx FIFO Element Count</description>
              <bitRange>[20:16]</bitRange>
              <access>read-only</access>
            </field>
            <!--TXFCNT: Curent Tx FIFO Element Count-->
            <field>
              <name>TXFCNT</name>
              <description>Curent Tx FIFO Element Count</description>
              <bitRange>[12:8]</bitRange>
              <access>read-only</access>
            </field>

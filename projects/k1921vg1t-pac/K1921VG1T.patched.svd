              <name>DRQACNT</name>
              <description>PWM DMA request event A counter</description>
              <bitRange>[19:18]</bitRange>
              <access>read-only</access>
            </field>
            <!--DRQAPRD: PWM DMA request A period select-->
            <field>
              <name>DRQAPRD</name>
              <description>PWM DMA request A period select</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--SOCBCNT: PWM ADC Start-of-Conversion B event (PWM_SOCB) counter register-->

              <name>S</name>
              <description>Suspend</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--OC: Over-current Change-->
            <field>
              <name>OC</name>
              <description>Over-current Change</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--OA: Over-current Active-->
            <field>
              <name>OA</name>
              <description>Over-current Active</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <!--PR: Port Reset-->
            <field>
              <name>PR</name>
              <description>Port Reset</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--LSDA: Low Speed Device Attached-->
            <field>
              <name>LSDA</name>
              <description>Low Speed Device Attached</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--RD: Resume Detect-->
            <field>
              <name>RD</name>
              <description>Resume Detect</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--LS: Line Status-->
            <field>
              <name>LS</name>
              <description>Line Status</description>
              <bitRange>[5:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--PE: Port Enable/Disable Change-->
            <field>
              <name>PE</name>
              <description>Port Enable/Disable Change</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--PED: Port Enabled/Disabled-->
            <field>
              <name>PED</name>
              <description>Port Enabled/Disabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CSC: Connect Status Change-->
            <field>
              <name>CSC</name>
              <description>Connect Status Change</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--CS: Current Connect Status-->
            <field>
              <name>CS</name>
              <description>Current Connect Status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--USBHC1-->
    <peripheral derivedFrom="USBHC0">
      <name>USBHC1</name>
      <baseAddress>0x41091000</baseAddress>
    </peripheral>

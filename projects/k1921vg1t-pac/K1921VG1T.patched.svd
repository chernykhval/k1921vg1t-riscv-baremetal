                <enumeratedValue>
                  <name>DIO</name>
                  <description>Instruction on two lines</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QIO</name>
                  <description>Instruction on four lines</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--INST: Instruction to be sent to the external SPI defice-->
            <field>
              <name>INST</name>
              <description>Instruction to be sent to the external SPI defice</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--QAD: QSPI Address Register  -->
        <register>
          <name>QAD</name>
          <description>QSPI Address Register  </description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
